@{
    ViewBag.Title = "Khuyến mãi";
    Layout = "~/Views/Shared/_CaiDat_Layout.cshtml";
}

<style>
    /* CSS cũ giữ nguyên */
    .voucher-input-section {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .voucher-input-wrapper {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .voucher-code-input {
        flex: 1;
        padding: 12px 16px;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 500;
        transition: border-color 0.3s ease;
    }

        .voucher-code-input:focus {
            outline: none;
            border-color: #F58634;
        }

    .btn-save-voucher {
        background-color: #F58634;
        color: white;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

        .btn-save-voucher:hover {
            background-color: #e67e00;
        }

    /* CSS Voucher Card */
    .voucher-card {
        background: #fff;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: all 0.3s ease;
        position: relative;
    }

        .voucher-card:hover:not(.disabled-voucher) {
            border-color: #F58634;
            box-shadow: 0 4px 12px rgba(245, 134, 52, 0.15);
        }

        .voucher-card.disabled-voucher {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .voucher-icon {
        font-size: 2rem;
        color: #F58634;
        min-width: 50px;
        text-align: center;
    }

    .voucher-info {
        flex: 1;
    }

    .voucher-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 4px;
    }

    .voucher-expiry {
        font-size: 0.9rem;
        color: #6c757d;
        margin-bottom: 4px;
    }

    .voucher-quantity {
        font-size: 0.85rem;
        color: #F58634;
        font-weight: 600;
    }

        .voucher-quantity.low-stock {
            color: #dc3545;
        }

    .voucher-code-display {
        background-color: #f8f9fa;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        color: #333;
        font-size: 0.95rem;
        min-width: 120px;
        text-align: center;
    }

    .voucher-status {
        position: absolute;
        top: 16px;
        right: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 12px;
    }

    .status-active {
        background-color: #d4edda;
        color: #155724;
    }

    .status-expired {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-used {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .empty-voucher {
        background: #fff;
        border: 2px dashed #ddd;
        border-radius: 12px;
        padding: 40px 20px;
        text-align: center;
        color: #6c757d;
    }

        .empty-voucher i {
            font-size: 3rem;
            color: #ddd;
            margin-bottom: 15px;
        }

    /* CSS Phân trang */
    .pagination {
        margin-top: 20px;
    }

    .page-link {
        color: #F58634;
        border-color: #dee2e6;
        cursor: pointer;
    }

        .page-link:hover {
            color: #e67e00;
            background-color: #fff8f0;
            border-color: #dee2e6;
        }

    .page-item.active .page-link {
        background-color: #F58634;
        border-color: #F58634;
        color: white;
    }

    .page-item.disabled .page-link {
        color: #6c757d;
        pointer-events: none;
    }
</style>

<h4 class="mb-4">Mã khuyến mãi của tôi</h4>

<!-- Ô TÌM KIẾM VOUCHER (Đã đổi từ Lưu sang Tìm kiếm) -->
<div class="voucher-input-section">
    <div class="voucher-input-wrapper">
        <input type="text"
               id="voucherSearchInput"
               class="voucher-code-input"
               placeholder="Tìm kiếm theo mã hoặc tên voucher..."
               maxlength="50">
        <button class="btn-save-voucher" onclick="TimKiemVoucher()">
            <i class="fas fa-search"></i> Tìm kiếm
        </button>
    </div>
</div>

<!-- Danh sách voucher -->
<div id="voucher-list">
    <div class="voucher-loading text-center py-5">
        <div class="spinner-border text-warning" role="status"></div>
        <p class="mt-3 text-muted">Đang tải danh sách voucher...</p>
    </div>
</div>

<!-- PHÂN TRANG -->
<div id="pagination"></div>

<script>
    var url_domain = window.location.origin;

    $(document).ready(function () {
        // Load trang đầu tiên khi vào
        LayDSVoucher(1);

        // Enter để tìm kiếm
        $('#voucherSearchInput').keypress(function (e) {
            if (e.which === 13) {
                TimKiemVoucher();
            }
        });
    });

    // Hàm kích hoạt tìm kiếm (Reset về trang 1)
    function TimKiemVoucher() {
        LayDSVoucher(1);
    }

    // Hàm gọi API lấy danh sách (Có keyword và page)
    function LayDSVoucher(page) {
        var keyword = $('#voucherSearchInput').val().trim();

        var formData = new FormData();
        formData.append('page', page);
        formData.append('pageSize', 5); // Số lượng voucher mỗi trang
        formData.append('keyword', keyword);

        // Hiển thị loading nhẹ nếu không phải lần đầu
        if (page > 1) {
            $('#voucher-list').css('opacity', '0.5');
        }

        $.ajax({
            type: "POST",
            url: url_domain + '/CaiDat/LayDSVoucher',
            data: formData, contentType: false, processData: false, cache: false,
            success: function (response) {
                $('#voucher-list').css('opacity', '1');
                var res = (typeof response === 'string') ? JSON.parse(response) : response;

                if (res.success) {
                    HienThiDSVoucher(res.data);
                    // Gọi hàm tạo phân trang
                    TaoPhanTrang(res.totalPages, res.currentPage);
                } else {
                    $('#voucher-list').html('<div class="alert alert-danger text-center">' + res.message + '</div>');
                    $("#pagination").html('');
                }
            },
            error: function () {
                $('#voucher-list').css('opacity', '1');
                $('#voucher-list').html('<div class="alert alert-danger text-center">Lỗi khi tải danh sách voucher</div>');
            }
        });
    }

    function HienThiDSVoucher(data) {
        if (data.length === 0) {
            $('#voucher-list').html(`
                <div class="empty-voucher">
                    <i class="fas fa-search-minus"></i>
                    <p>Không tìm thấy voucher nào phù hợp</p>
                </div>
            `);
            return;
        }

        var html = '';
        for (var i = 0; i < data.length; i++) {
            var v = data[i];
            var statusHtml = '';
            var cardClass = '';
            var quantityHtml = '';

            if (v.TrangThai === 'HetHan') {
                statusHtml = '<span class="voucher-status status-expired">Hết hạn</span>';
                cardClass = 'disabled-voucher';
            } else if (v.TrangThai === 'HetLuot') {
                statusHtml = '<span class="voucher-status status-used">Hết lượt</span>';
                cardClass = 'disabled-voucher';
            } else {
                statusHtml = '<span class="voucher-status status-active">Còn hạn</span>';
                var qtyClass = v.SoLuotConLai <= 10 ? 'low-stock' : '';
                quantityHtml = `<div class="voucher-quantity ${qtyClass}"><i class="fas fa-box"></i> Còn lại: ${v.SoLuotConLai} lượt</div>`;
            }

            html += `
                <div class="voucher-card ${cardClass}">
                    <div class="voucher-icon"><i class="fas fa-ticket-alt"></i></div>
                    <div class="voucher-info">
                        <div class="voucher-title">${v.TenVoucher}</div>
                        <div class="text-success fw-bold small mb-1">${v.GiaTriText}</div>
                        <div class="voucher-expiry"><i class="far fa-clock"></i> HSD: ${v.ThoiGian}</div>
                        ${quantityHtml}
                    </div>
                    <div class="d-flex flex-column align-items-center gap-2">
                        <div class="voucher-code-display">${v.MaCode}</div>
                        <button class="btn btn-sm btn-outline-secondary w-100" onclick="CopyMa('${v.MaCode}')">Sao chép</button>
                    </div>
                    ${statusHtml}
                </div>`;
        }
        $('#voucher-list').html(html);
    }

    function CopyMa(code) {
        navigator.clipboard.writeText(code);
        // Có thể thay bằng toast message đẹp hơn
        alert("Đã sao chép mã: " + code);
    }

    // --- LOGIC PHÂN TRANG (Đã sửa đổi cho Voucher) ---
    function TaoPhanTrang(totalPages, currentPage) {
        totalPages = parseInt(totalPages);
        currentPage = parseInt(currentPage);

        if (isNaN(totalPages) || totalPages <= 1) {
            $("#pagination").html('');
            return;
        }

        // Helper render nút
        function renderItem(page, isActive, isDisabled, text) {
            var activeClass = isActive ? "active" : "";
            var disabledClass = isDisabled ? "disabled" : "";

            // QUAN TRỌNG: Gọi LayDSVoucher(page) khi click
            var clickEvent = (isDisabled || isActive) ? "" : `onclick="LayDSVoucher(${page})"`;

            var display = text || page;
            return `<li class="page-item ${activeClass} ${disabledClass}"><a class="page-link" href="javascript:void(0)" ${clickEvent}>${display}</a></li>`;
        }

        function renderDots() { return `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`; }

        var html = `<nav><ul class="pagination pagination-sm justify-content-center">`;
        html += renderItem(currentPage - 1, false, currentPage === 1, "&laquo;");

        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) html += renderItem(i, i === currentPage, false, i);
        } else {
            html += renderItem(1, 1 === currentPage, false, 1);
            var startPage = Math.max(2, currentPage - 1);
            var endPage = Math.min(totalPages - 1, currentPage + 1);

            if (startPage > 2) html += renderDots();
            for (let i = startPage; i <= endPage; i++) html += renderItem(i, i === currentPage, false, i);
            if (endPage < totalPages - 1) html += renderDots();
            html += renderItem(totalPages, totalPages === currentPage, false, totalPages);
        }
        html += renderItem(currentPage + 1, false, currentPage === totalPages, "&raquo;");
        html += `</ul></nav>`;

        $("#pagination").html(html);
    }
</script>