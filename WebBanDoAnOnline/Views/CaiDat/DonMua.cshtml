﻿
@{
    ViewBag.Title = "Đơn mua";
    Layout = "~/Views/Shared/_CaiDat_Layout.cshtml";
}

<style>
    /* CSS cho Card đơn hàng */
    .order-card {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 24px;
        background: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        border-bottom: 2px dashed #e0e0e0;
        padding-bottom: 16px;
    }

    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

        .status-badge.pending {
            background: #FFF3E0;
            color: #F58634;
        }

        .status-badge.shipping {
            background: #E3F2FD;
            color: #2196F3;
        }

        .status-badge.completed {
            background: #E8F5E9;
            color: #4CAF50;
        }

        .status-badge.cancelled {
            background: #FFEBEE;
            color: #F44336;
        }

    .product-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .product-img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 8px;
    }

    .product-price {
        font-weight: 700;
        color: #F58634;
    }

    .filter-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 24px;
        border-bottom: 2px solid #eee;
    }

    .filter-tab {
        padding: 10px 20px;
        border: none;
        background: transparent;
        cursor: pointer;
        font-weight: 500;
        color: #666;
    }

        .filter-tab.active {
            color: #F58634;
            font-weight: 600;
            border-bottom: 3px solid #F58634;
            margin-bottom: -2px;
        }

    .btn-action {
        padding: 8px 16px;
        border-radius: 6px;
        border: 1px solid #ddd;
        background: white;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }

        /* --- SỬA LỖI HIỂN THỊ NÚT MUA LẠI --- */
        /* Ghi đè background white của .btn-action khi là nút màu cam */
        .btn-action.btn-warning {
            background-color: #F58634 !important;
            border-color: #F58634 !important;
            color: white !important;
        }

            .btn-action.btn-warning:hover {
                background-color: #e0701b !important;
                color: white !important;
            }
</style>

<h4 class="mb-4">Đơn mua của tôi</h4>

@if (TempData["Msg"] != null)
{<div class="alert alert-success">@TempData["Msg"]</div>}
@if (TempData["Err"] != null)
{<div class="alert alert-danger">@TempData["Err"]</div>}

<!-- Bộ lọc -->
<div class="filter-tabs">
    <button class="filter-tab active" onclick="DoiTab('all', this)"><i class="fas fa-list"></i> Tất cả</button>
    <button class="filter-tab" onclick="DoiTab('pending', this)"><i class="fas fa-clock"></i> Chờ xác nhận</button>
    <button class="filter-tab" onclick="DoiTab('shipping', this)"><i class="fas fa-shipping-fast"></i> Đang giao</button>
    <button class="filter-tab" onclick="DoiTab('completed', this)"><i class="fas fa-check-circle"></i> Hoàn thành</button>
    <button class="filter-tab" onclick="DoiTab('cancelled', this)"><i class="fas fa-times-circle"></i> Đã hủy</button>
</div>

<!-- Danh sách đơn hàng -->
<div id="order-list">
    <div class="text-center py-5">
        <div class="spinner-border text-warning" role="status"><span class="visually-hidden">Đang tải...</span></div>
    </div>
</div>

<script>
    var trangThaiHienTai = 'all';

    $(document).ready(function () {
        LayDonMua(trangThaiHienTai);
    });

    function DoiTab(status, btn) {
        $('.filter-tab').removeClass('active');
        $(btn).addClass('active');
        trangThaiHienTai = status;
        LayDonMua(status);
    }

    function LayDonMua(status) {
        var formData = new FormData();
        formData.append('status', status);

        $.ajax({
            type: "POST",
            url: '/CaiDat/LayDonMua',
            data: formData, contentType: false, processData: false, cache: false,
            success: function (res) {
                // Parse nếu server trả về string JSON
                var data = (typeof res === 'string') ? JSON.parse(res) : res;
                if (data.success) {
                    HienThiDanhSach(data.data);
                } else {
                    $('#order-list').html('<div class="alert alert-danger text-center">' + data.message + '</div>');
                }
            },
            error: function () {
                $('#order-list').html('<div class="alert alert-danger text-center">Lỗi kết nối server</div>');
            }
        });
    }

    function HienThiDanhSach(orders) {
        var html = '';
        if (orders.length === 0) {
            html = `<div class="text-center py-5 text-muted">
                        <i class="fas fa-shopping-bag fa-3x mb-3"></i>
                        <h5>Chưa có đơn hàng nào</h5>
                        <a href="/SanPham/KH_DanhSachSanPham" class="btn btn-warning text-white mt-2">Đặt món ngay</a>
                    </div>`;
        } else {
            orders.forEach(function (order) {
                var statusInfo = XuLyTrangThai(order.TrangThai);

                html += `
                    <div class="order-card">
                        <div class="order-header">
                            <div>
                                <strong>${order.MaVanDon}</strong> <br>
                                <small class="text-muted"><i class="far fa-calendar"></i> ${order.NgayTao}</small>
                            </div>
                            <span class="status-badge ${statusInfo.class}"><i class="${statusInfo.icon}"></i> ${statusInfo.text}</span>
                        </div>

                        <div class="product-list">
                            ${order.SanPhams.map(sp => {
                    // 1. XỬ LÝ ẢNH
                    var imgUrl = sp.Anh ? sp.Anh.replace("~", "") : "/Content/img/no-image.png";

                    // 2. XỬ LÝ NÚT ĐÁNH GIÁ
                    var btnDanhGia = '';
                    if (order.TrangThai === 'Đã nhận hàng') {
                        if (sp.DaDanhGia === true) {
                            btnDanhGia = `<div class="mt-2 text-success small fw-bold"><i class="fas fa-check-circle"></i> Đã đánh giá</div>`;
                        } else {
                            btnDanhGia = `<a href="/DanhGia/KH_DanhGiaSanPham?maDH=${order.MaDH}&maSP=${sp.MaSP}"
                                                         class="btn btn-sm btn-outline-warning ms-auto mt-2">
                                                         <i class="far fa-star"></i> Viết đánh giá
                                                      </a>`;
                        }
                    }

                    return `
                                <div class="product-item">
                                    <img src="${imgUrl}" class="product-img" onerror="this.src='/Content/img/no-image.png'">
                                    <div class="product-info flex-grow-1">
                                        <div class="fw-bold text-dark">${sp.TenSP}</div>
                                        <div class="text-muted small">x${sp.SoLuong}</div>
                                    </div>
                                    <div class="d-flex flex-column align-items-end">
                                        <div class="product-price mb-2">${DinhDangTienTe(sp.DonGia)}đ</div>
                                        ${btnDanhGia}
                                    </div>
                                </div>`;
                }).join('')}
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <span class="text-muted">Tổng tiền:</span>
                            <span class="fs-5 fw-bold text-danger">${DinhDangTienTe(order.TongTien)}đ</span>
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                             ${LayNutHanhDong(order.TrangThai, order.MaDH)}
                        </div>
                    </div>`;
            });
        }
        $('#order-list').html(html);
    }

    function XuLyTrangThai(status) {
        switch (status) {
            case 'Chờ xác nhận': return { class: 'pending', icon: 'fas fa-clock', text: 'Chờ xác nhận' };
            case 'Đã xác nhận': return { class: 'shipping', icon: 'fas fa-box', text: 'Đã xác nhận' };
            case 'Đang giao': return { class: 'shipping', icon: 'fas fa-shipping-fast', text: 'Đang giao' };
            case 'Đã nhận hàng': return { class: 'completed', icon: 'fas fa-check-circle', text: 'Hoàn thành' };
            case 'Đã hủy': return { class: 'cancelled', icon: 'fas fa-times-circle', text: 'Đã hủy' };
            default: return { class: 'pending', icon: 'fas fa-info', text: status };
        }
    }

    function LayNutHanhDong(status, maDH) {
        var btnChiTiet = `<a href="/DonHang/ChiTietDonHang/${maDH}" class="btn-action border-secondary text-secondary ms-2">Chi tiết đơn</a>`;

        if (!status) return btnChiTiet;
        var s = status.trim();
        var sLower = s.toLowerCase();

        // 1. Trạng thái "Chờ xác nhận" -> Hiện nút Hủy
        if (s === 'Chờ xác nhận') {
            return `<button class="btn-action text-danger border-danger" onclick="HuyDonHang(${maDH})">Hủy đơn</button>` + btnChiTiet;
        }

        // 2. Trạng thái Hoàn thành/Hủy -> Hiện nút Mua lại
        if (sLower === 'đã nhận hàng' || sLower === 'đã hủy' || sLower === 'hoàn thành') {
            return `<a href="/SanPham/KH_DanhSachSanPham" class="btn-action btn-warning">Mua lại</a>` + btnChiTiet;
        }

        // 3. Các trạng thái khác (Đang giao...) -> Chỉ hiện nút Chi tiết
        return btnChiTiet;
    }

    function DinhDangTienTe(n) { return new Intl.NumberFormat('vi-VN').format(n); }

    function HuyDonHang(id) {
        if (!confirm('Bạn có chắc muốn hủy đơn hàng này?')) return;
        var fd = new FormData(); fd.append('id', id);
        $.ajax({
            type: "POST", url: '/CaiDat/HuyDonHang', data: fd, contentType: false, processData: false,
            success: function (res) {
                var r = JSON.parse(res);
                alert(r.message);
                if (r.success) LayDonMua(trangThaiHienTai);
            }
        });
    }
</script>