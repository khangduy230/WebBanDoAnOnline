@{
    ViewBag.Title = "Hồ sơ";
    Layout = "~/Views/Shared/_CaiDat_Layout.cshtml";
}

<style>
    /* Style giữ nguyên */
    .profile-avatar {
        text-align: center;
        margin-bottom: 30px;
    }

    .avatar-img {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #F58634;
        margin-bottom: 15px;
    }

    .btn-change-avatar {
        background-color: #F58634;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background-color 0.2s;
    }

        .btn-change-avatar:hover {
            background-color: #e67e00;
        }

    #avatarInput {
        display: none;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #333;
        }

    .form-control-custom {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
    }

        .form-control-custom:focus {
            outline: none;
            border-color: #F58634;
        }

    .btn-save {
        background-color: #F58634;
        color: white;
        border: none;
        padding: 12px 40px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-top: 20px;
    }

        .btn-save:hover {
            background-color: #e67e00;
        }
</style>

<h4 class="mb-4">Thông tin cá nhân</h4>

<!-- Avatar Section -->
<div class="profile-avatar">
    <img id="avatarPreview" src="~/img/default-avatar.png" alt="Avatar" class="avatar-img">
    <br>
    <button type="button" class="btn-change-avatar" onclick="$('#avatarInput').click()">
        <i class="fas fa-camera"></i> Thay đổi ảnh đại diện
    </button>
    <input type="file" id="avatarInput" accept="image/*">
</div>

<!-- Profile Form -->
<form id="profileForm">
    <div class="form-group">
        <label for="fullName">Họ và tên</label>
        <input type="text" id="fullName" class="form-control-custom" placeholder="Nguyễn Văn A" required>
    </div>

    <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" class="form-control-custom" placeholder="example@email.com" required>
    </div>

    <div class="form-group">
        <label for="phone">Số điện thoại</label>
        <!-- THÊM oninput: Chặn nhập chữ -->
        <input type="tel" id="phone" class="form-control-custom" placeholder="0123456789"
               oninput="this.value = this.value.replace(/[^0-9]/g, '')" required>
    </div>

    <div class="form-group">
        <label for="question">Câu hỏi bảo mật</label>
        <select id="question" class="form-control-custom" required>
            <option value="">-- Chọn câu hỏi --</option>
            <option value="Bạn thích ăn món gì nhất">Bạn thích ăn món gì nhất?</option>
            <option value="Bạn thích điều gì nhất ở nhà hàng của chúng tôi">Bạn thích điều gì nhất ở nhà hàng của chúng tôi?</option>
            <option value="Tên thú cưng đầu tiên của bạn là gì">Tên thú cưng đầu tiên của bạn là gì?</option>
        </select>
    </div>

    <div class="form-group">
        <label for="answer">Câu trả lời</label>
        <input type="text" id="answer" class="form-control-custom" placeholder="Nhập câu trả lời bảo mật" required>
    </div>

    <button type="submit" class="btn-save">Lưu thay đổi</button>
</form>

<script>
    var selectedAvatar = null;
    var url_domain = window.location.origin;

    $(document).ready(function () {
        LayHoSo();

        // Xem trước ảnh khi chọn file
        $('#avatarInput').change(function (e) {
            var file = e.target.files[0];
            if (file) {
                selectedAvatar = file;
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#avatarPreview').attr('src', e.target.result);
                };
                reader.readAsDataURL(file);
            }
        });

        // Xử lý Lưu
        $('#profileForm').submit(function (e) {
            e.preventDefault();
            LuuHoSo();
        });
    });

    // Hàm lấy thông tin hồ sơ
    function LayHoSo() {
        $.ajax({
            type: "POST",
            url: '/CaiDat/LayHoSo',
            contentType: false, processData: false, cache: false,
            success: function (response) {
                var res = (typeof response === 'string') ? JSON.parse(response) : response;

                if (res.success) {
                    $('#fullName').val(res.data.HoTen || '');
                    $('#email').val(res.data.Email || '');
                    $('#phone').val(res.data.SoDienThoai || '');
                    $('#question').val(res.data.CauHoi || '');
                    $('#answer').val(res.data.TraLoi || '');

                    if (res.data.Avatar) {
                        var imgUrl = res.data.Avatar.replace("~", "") + "?v=" + new Date().getTime();
                        $('#avatarPreview').attr('src', imgUrl);
                    }
                } else {
                    if (res.message === "Chưa đăng nhập") {
                        window.location.href = "/TaiKhoan/DangNhap";
                    } else {
                        // alert(res.message); // Có thể comment lại để đỡ phiền lúc load trang
                    }
                }
            },
            error: function () {
                console.error("Lỗi gọi API LayHoSo");
            }
        });
    }

    // Hàm lưu thông tin hồ sơ (ĐÃ CẬP NHẬT VALIDATE)
    function LuuHoSo() {
        // 1. Lấy dữ liệu để kiểm tra
        var fullName = $('#fullName').val().trim();
        var email = $('#email').val().trim();
        var phone = $('#phone').val().trim();
        var question = $('#question').val();
        var answer = $('#answer').val().trim();

        // 2. --- BẮT ĐẦU VALIDATE ---

        // Kiểm tra rỗng
        if (!fullName || !email || !phone || !question || !answer) {
            alert("Vui lòng nhập đầy đủ thông tin!");
            return;
        }

        // Validate SĐT (9-11 số)
        if (!/^\d{9,11}$/.test(phone)) {
            alert("Số điện thoại không hợp lệ (Phải là số và có từ 9-11 ký tự).");
            $('#phone').focus();
            return;
        }

        // Validate Email
        var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!emailRegex.test(email)) {
            alert("Email không đúng định dạng.");
            $('#email').focus();
            return;
        }

        // 3. --- GỬI AJAX ---
        var btn = $(".btn-save");
        btn.prop("disabled", true).text("Đang lưu...");

        var formData = new FormData();
        formData.append('HoTen', fullName);
        formData.append('Email', email);
        formData.append('SoDienThoai', phone);
        formData.append('CauHoi', question);
        formData.append('TraLoi', answer);

        if (selectedAvatar) {
            formData.append('Avatar', selectedAvatar);
        }

        $.ajax({
            type: "POST",
            url: '/CaiDat/LuuHoSo',
            data: formData,
            contentType: false, processData: false, cache: false,
            success: function (response) {
                var res = (typeof response === 'string') ? JSON.parse(response) : response;

                if (res.success) {
                    alert('Cập nhật hồ sơ thành công!');
                    window.location.reload();
                } else {
                    alert(res.message);
                    btn.prop("disabled", false).text("Lưu thay đổi");
                }
            },
            error: function () {
                alert('Lỗi kết nối server!');
                btn.prop("disabled", false).text("Lưu thay đổi");
            }
        });
    }
</script>