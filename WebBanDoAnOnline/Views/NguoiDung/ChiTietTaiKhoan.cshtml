.cshtml
@{
    ViewBag.Title = "Quản lý - Chi tiết tài khoản";
    Layout = "~/Views/Shared/_QL_Layout.cshtml";
    var userId = ViewBag.UserId ?? "";
}
<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="fw-bold mb-0">Chi tiết tài khoản</h3>
        <div class="btn-group">
            <a href="@Url.Action("QL_DanhSachNguoiDung","NguoiDung")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div id="panelError" class="alert alert-danger d-none"></div>
    <div id="roleNotice" class="alert d-none"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <img id="avatar" src="/img/no-image.jpg" alt="avatar" class="rounded-circle" style="width:84px;height:84px;object-fit:cover;">
                        <div class="flex-grow-1">
                            <h4 id="hoTen" class="fw-bold mb-1">...</h4>
                            <div class="text-muted mb-2">
                                <span id="vaiTro" class="badge bg-dark me-2">...</span>
                                <span id="trangThai" class="badge bg-success">...</span>
                            </div>
                            <div class="text-muted">
                                <i class="far fa-envelope me-2"></i><span id="email">...</span>
                                <span class="mx-2">•</span>
                                <i class="fas fa-phone me-2"></i><span id="sdt">...</span>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted" id="lblTongDon">Tổng số đơn</div>
                                <div id="tongDon" class="fs-4 fw-bold">0</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted">Ngày tạo</div>
                                <div id="createAt" class="fw-semibold">...</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted">Cập nhật gần nhất</div>
                                <div id="updateAt" class="fw-semibold">...</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <h5 class="fw-bold mb-2">Đơn hàng gần nhất</h5>
                        <div id="lastOrder" class="border rounded p-3">
                            <div class="text-muted">Chưa có dữ liệu</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Hành động nhanh</h5>
                    <div class="d-grid gap-2">
                        <a class="btn btn-dark" href="@Url.Action("QL_SuaNguoiDung","NguoiDung")?id=@userId"><i class="fas fa-pen me-2"></i>Sửa thông tin</a>
                        <a id="btnViewOrders" class="btn btn-outline-primary" href="@Url.Action("QL_DanhSachDonHang","DonHang")?keyword=@userId"><i class="fas fa-file-invoice me-2"></i>Xem đơn hàng</a>
                        <button id="btnToggle" class="btn btn-outline-danger"><i class="fas fa-user-slash me-2"></i><span>Khóa/Mở</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
(function(){
    const id = '@(userId)';
    const apiDetail = '@Url.Action("QL_LayChiTietNguoiDung","NguoiDung")';
    const apiToggle = '@Url.Action("DatTrangThai","NguoiDung")';

    function badgeStatus(s){
        if(!s) return '<span class="badge bg-secondary">N/A</span>';
        if((s||'').toLowerCase().indexOf('khóa')>=0 || (s||'').toLowerCase().indexOf('xóa')>=0)
            return '<span class="badge bg-danger">'+s+'</span>';
        return '<span class="badge bg-success">'+s+'</span>';
    }

    function styleRoleBadge(role){
        const r = (role||'').toLowerCase();
        const $v = $('#vaiTro');
        if(r.indexOf('quản lý')>=0){
            $v.attr('class', 'badge bg-danger me-2').text(role); // Quản trị nổi bật (đỏ)
        }else if(r.indexOf('nhân viên')>=0){
            $v.attr('class', 'badge bg-primary me-2').text(role); // Nội bộ (xanh dương)
        }else{
            $v.attr('class', 'badge bg-secondary me-2').text(role); // Khách hàng (xám)
        }
    }

    function renderLastOrder(o){
        if(!o){
            $('#lastOrder').html('<div class="text-muted">Chưa có dữ liệu</div>');
            return;
        }
        const mapStatus = (t)=>{
            if(t==='Đang giao' || t==='Đã xác nhận') return '<span class="badge bg-info text-dark">'+t+'</span>';
            if(t==='Đã nhận hàng') return '<span class="badge bg-primary">'+t+'</span>';
            if(t==='Đã hủy') return '<span class="badge bg-danger">'+t+'</span>';
            return '<span class="badge bg-warning text-dark">'+(t||'Chờ xác nhận')+'</span>';
        };
        const money = (n)=> Number(n||0).toFixed(0).replace(/(\d)(?=(\d{3})+(?!\d))/g,'$1.')+'đ';
        $('#lastOrder').html(`
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold">Đơn #${String(o.MaDH).padStart(6,'0')}</div>
                    <div class="text-muted">${o.time||''}</div>
                </div>
                <div class="text-end">
                    ${mapStatus(o.TrangThai)}
                    <div class="fw-bold mt-1">${money(o.TongTien)}</div>
                </div>
            </div>
        `);
    }

    function applyRoleUi(role){
        const r = (role||'').toLowerCase();
        const $notice = $('#roleNotice').addClass('d-none').removeClass('alert-info alert-warning alert-danger');
        const $btnToggle = $('#btnToggle');
        const $btnOrders = $('#btnViewOrders');
        const $lblTongDon = $('#lblTongDon');

        // mặc định
        $btnToggle.prop('disabled', false).removeClass('disabled').attr('title','');
        $btnOrders.html('<i class="fas fa-file-invoice me-2"></i>Xem đơn hàng');
        $lblTongDon.text('Tổng số đơn');

        if(r.indexOf('quản lý')>=0){
            // Quản lý: cảnh báo + khóa nút Toggle
            $notice.removeClass('d-none').addClass('alert alert-warning')
                   .text('Tài khoản Quản lý có quyền cao, thao tác khóa/mở bị vô hiệu hóa tại đây.');
            $btnToggle.prop('disabled', true).addClass('disabled').attr('title','Không thể khóa tài khoản Quản lý');
            $lblTongDon.text('Tổng tác vụ/đơn liên quan (theo tài khoản)');
        }else if(r.indexOf('nhân viên')>=0){
            // Nhân viên: đổi nhãn phù hợp
            $notice.removeClass('d-none').addClass('alert alert-info')
                   .text('Tài khoản Nhân viên (nội bộ). Bạn có thể cập nhật thông tin, xem các đơn do tài khoản này thực hiện.');
            $btnOrders.html('<i class="fas fa-file-invoice me-2"></i>Đơn liên quan đến nhân viên');
            $lblTongDon.text('Đơn liên quan đến nhân viên');
        }else{
            // Khách hàng
            $notice.removeClass('d-none').addClass('alert alert-info')
                   .text('Tài khoản Khách hàng. Bạn có thể xem lịch sử đơn hàng và quản lý trạng thái tài khoản.');
            $lblTongDon.text('Tổng số đơn của khách');
        }
    }

    function load(){
        $.post(apiDetail, { id: id }, function(res){
            try{
                const data = typeof res==='string' ? JSON.parse(res) : res;
                if(data.error){
                    $('#panelError').removeClass('d-none').text(data.error==='not_found'?'Không tìm thấy tài khoản':'Lỗi: '+(data.message||data.error));
                    return;
                }
                $('#hoTen').text(data.hoTen||'');
                $('#email').text(data.email||'');
                $('#sdt').text(data.sdt||'');
                styleRoleBadge(data.vaiTro||'');
                $('#trangThai').html(badgeStatus(data.trangThai));
                $('#tongDon').text(data.tongDon||0);
                $('#createAt').text(data.createAt||'');
                $('#updateAt').text(data.updateAt||'');
                renderLastOrder(data.donGanNhat);
                applyRoleUi(data.vaiTro||'');
            }catch(e){
                $('#panelError').removeClass('d-none').text('Lỗi parse dữ liệu.');
            }
        });
    }

    $('#btnToggle').on('click', function(){
        if($(this).prop('disabled')) return;
        if(!confirm('Xác nhận thực hiện thao tác Khóa/Mở khóa cho tài khoản này?')) return;
        $.ajax({
            type: 'POST',
            url: apiToggle,
            data: (function(){ var fd = new FormData(); fd.append('id', id); return fd; })(),
            processData: false,
            contentType: false,
            success: function(msg){
                alert(msg || 'Thực hiện thành công');
                load();
            },
            error: function(){
                alert('Không thể cập nhật trạng thái tài khoản.');
            }
        });
    });

    load();
})();
    </script>
}