@{
    ViewBag.Title = "Thực đơn";
    Layout = "~/Views/Shared/_KH_Layout.cshtml";
}

<style>
    /* --- 1. CSS DANH MỤC (VIÊN THUỐC) --- */
    .cat-btn {
        border: 1px solid #eee;
        background: #fff;
        color: #555;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.2s;
        white-space: nowrap;
        cursor: pointer;
    }

        .cat-btn:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
        }

        .cat-btn.active {
            background: #ffc107; /* Màu vàng */
            color: #000;
            border-color: #ffc107;
            font-weight: 700;
            box-shadow: 0 4px 10px rgba(255, 193, 7, 0.3);
        }

    /* --- 2. CSS SẢN PHẨM (GIỐNG ẢNH MẪU) --- */
    .product-card-custom {
        background: #fff;
        border: none;
        border-radius: 20px; /* Bo góc to cho toàn bộ thẻ */
        box-shadow: 0 4px 20px rgba(0,0,0,0.08); /* Bóng mờ nhẹ */
        padding: 12px; /* Khoảng cách từ viền vào nội dung */
        transition: transform 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .product-card-custom:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }

    .img-wrapper {
        width: 100%;
        height: 180px;
        overflow: hidden;
        border-radius: 12px; /* Bo góc cho ảnh */
        margin-bottom: 12px;
    }

        .img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .card-title-custom {
        font-weight: 700;
        font-size: 1.1rem;
        color: #000;
        margin-bottom: 5px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-align: left; /* Căn trái */
    }

    .price-custom {
        font-weight: 700;
        font-size: 1.1rem;
        color: #222;
        margin-bottom: 8px;
        text-align: left; /* Căn trái */
    }

    .meta-info {
        display: flex;
        justify-content: space-between;
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .btn-add-custom {
        background-color: #ffc107; /* Màu vàng chuẩn */
        color: #000;
        font-weight: 700;
        border: none;
        border-radius: 8px; /* Bo góc nút */
        width: 100%;
        padding: 8px 0;
        transition: 0.2s;
        margin-top: auto; /* Đẩy nút xuống đáy */
    }

        .btn-add-custom:hover {
            background-color: #e0a800;
        }

    /* Thanh cuộn danh mục */
    .category-scroll {
        scrollbar-width: thin;
        -ms-overflow-style: none;
        padding-bottom: 5px;
    }

        .category-scroll::-webkit-scrollbar {
            height: 4px;
        }

        .category-scroll::-webkit-scrollbar-thumb {
            background: #ddd;
            border-radius: 4px;
        }
</style>

<div class="container mb-5 mt-4">

    <!-- 1. TOOLBAR: Danh mục (Căn trái) -->
    <div class="mb-4">
        <h4 class="fw-bold mb-3 text-start">Thực đơn</h4> <!-- Căn trái tiêu đề -->
        <!-- Danh mục căn trái (justify-content-start) -->
        <div id="category-list" class="category-scroll d-flex justify-content-start gap-2 overflow-auto">
            <!-- JS sẽ render nút vào đây -->
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
        </div>
    </div>

    <!-- 2. LƯỚI SẢN PHẨM -->
    <div id="product-grid" class="row g-3">
        <!-- JS render sản phẩm vào đây -->
    </div>

    <!-- 3. PHÂN TRANG -->
    <div id="pagination" class="d-flex justify-content-center mt-5"></div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>
    var url_domain = window.location.origin;
    var activeCategoryId = null;
    var currentPage = 1;

    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const kwParam = urlParams.get('searchTerm');
        var searchInput = $("#global-search");

        if (kwParam) {
            searchInput.val(kwParam);
            LayDanhMuc(false);
            TaiSanPham(null, kwParam, 1);
        } else {
            LayDanhMuc(true);
        }

        var searchTimeout;
        searchInput.off('keyup').on("keyup", function () {
            var keyword = $(this).val();
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function () {
                TaiSanPham(activeCategoryId, keyword, 1);
            }, 500);
        });
    });

    // --- HÀM 1: TẢI DANH MỤC ---
    function LayDanhMuc(autoTaiSanPham) {
        $.ajax({
            type: "POST",
            url: url_domain + '/DanhMuc/Lay_DSDM',
            processData: false, contentType: false, cache: false,
            success: function (res) {
                var cats = (typeof res === 'string') ? JSON.parse(res) : res;
                var container = $("#category-list");
                container.empty();

                var allActive = (activeCategoryId === null) ? 'active' : '';
                container.append(`<button onclick="DoiDanhMuc(null)" class="cat-btn ${allActive}">Tất cả</button>`);

                if (cats && cats.length > 0) {
                    cats.forEach(c => {
                        var isActive = (c.MaDM == activeCategoryId) ? 'active' : '';
                        container.append(`<button onclick="DoiDanhMuc(${c.MaDM})" class="cat-btn ${isActive}">${c.TenDM}</button>`);
                    });
                }

                if (autoTaiSanPham && activeCategoryId === null) {
                    TaiSanPham(null, "");
                }
            }
        });
    }

    // --- HÀM 2: ĐỔI DANH MỤC ---
    function DoiDanhMuc(id) {
        activeCategoryId = id;
        $("#global-search").val("");

        // Cập nhật giao diện nút Active (Thủ công để mượt hơn)
        $(".cat-btn").removeClass("active");
        LayDanhMuc(false); // Render lại để cập nhật class active chính xác

        TaiSanPham(id, "", 1);
    }

    // --- HÀM 3: TẢI SẢN PHẨM (GIAO DIỆN MỚI GIỐNG ẢNH) ---
    function TaiSanPham(maDM, searchTerm, page) {
        currentPage = page;
        var formData = new FormData();
        if (maDM !== null) formData.append('maDM', maDM);
        formData.append('searchTerm', searchTerm || "");
        formData.append('page', page);

        $.ajax({
            type: "POST",
            url: url_domain + '/SanPham/Lay_Menu',
            data: formData,
            processData: false, contentType: false, cache: false,
            beforeSend: function () {
                $("#product-grid").html('<div class="col-12 text-center py-5"><div class="spinner-border text-warning" role="status"></div></div>');
            },
            success: function (res) {
                var data = (typeof res === 'string') ? JSON.parse(res) : res;
                var products = data.Products;
                var grid = $("#product-grid");
                grid.empty();

                if (!products || products.length === 0) {
                    grid.html('<div class="col-12 text-center py-5 text-muted"><h5>Không tìm thấy món ăn nào.</h5></div>');
                    $("#pagination").html("");
                    return;
                }

                products.forEach(function (p) {
                    var imgUrl = p.Anh ? url_domain + p.Anh.replace('~/', '/') : "/Content/img/no-image.png";

                    // Giả lập thời gian giao (nếu API chưa trả về thì mặc định ~15p cho giống ảnh)
                    
                    // Giả lập rating
                    var rating = p.DiemDanhGia || 0;

                    // HTML GIỐNG HỆT ẢNH MẪU
                    var html = `
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card-custom">
                            <a href="/SanPham/ChiTietSanPham?maSP=${p.MaSP}" class="text-decoration-none text-dark">
                                <!-- Ảnh có bo góc riêng -->
                                <div class="img-wrapper">
                                    <img src="${imgUrl}" alt="${p.TenSP}" />
                                </div>

                                <!-- Tiêu đề căn trái -->
                                <h6 class="card-title-custom" title="${p.TenSP}">${p.TenSP}</h6>

                                <!-- Giá tiền căn trái -->
                                <div class="price-custom">${DinhDangTienTe(p.Gia)}</div>

                                <!-- Thông tin phụ: Thời gian & Sao -->
                                <div class="meta-info">
                                 
                                    <span><i class="fas fa-star text-warning"></i> ${rating}</span>
                                </div>
                            </a>

                            <!-- Nút Thêm màu vàng -->
                            <button class="btn-add-custom" onclick="ThemVaoGio(${p.MaSP})">
                                <i class="fa fa-shopping-cart"></i> Thêm
                            </button>
                        </div>
                    </div>`;
                    grid.append(html);
                });

                TaoPhanTrang(data.TotalPages, data.CurrentPage);
            },
            error: function () {
                $("#product_grid").html('<div class="text-center text-danger">Lỗi kết nối server.</div>');
            }
        });
    }

    function DinhDangTienTe(n) {
        return isNaN(n) ? "0 đ" : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
    }

    // --- HÀM 5: PHÂN TRANG ---
    function TaoPhanTrang(totalPages, currentPage) {
        totalPages = parseInt(totalPages);
        currentPage = parseInt(currentPage);
        if (isNaN(totalPages) || totalPages <= 1) { $("#pagination").html(''); return; }

        var kword = $("#global-search").val() || "";
        var kwordSafe = kword.replace(/'/g, "\\'");
        var catParam = (activeCategoryId === null) ? 'null' : activeCategoryId;

        function renderItem(page, isActive, isDisabled, text) {
            var activeClass = isActive ? "active" : "";
            var disabledClass = isDisabled ? "disabled" : "";
            var clickEvent = (isDisabled || isActive) ? "" : `onclick="TaiSanPham(${catParam}, '${kwordSafe}', ${page})"`;
            var display = text || page;
            return `<li class="page-item ${activeClass} ${disabledClass}"><a class="page-link" href="javascript:void(0)" ${clickEvent}>${display}</a></li>`;
        }
        function renderDots() { return `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`; }

        var html = `<nav><ul class="pagination pagination-sm justify-content-center">`;
        html += renderItem(currentPage - 1, false, currentPage === 1, "&laquo;");

        if (totalPages <= 7) {
            for (let i = 1; i <= totalPages; i++) html += renderItem(i, i === currentPage, false, i);
        } else {
            html += renderItem(1, 1 === currentPage, false, 1);
            var startPage = Math.max(2, currentPage - 1);
            var endPage = Math.min(totalPages - 1, currentPage + 1);
            if (startPage > 2) html += renderDots();
            for (let i = startPage; i <= endPage; i++) html += renderItem(i, i === currentPage, false, i);
            if (endPage < totalPages - 1) html += renderDots();
            html += renderItem(totalPages, totalPages === currentPage, false, totalPages);
        }
        html += renderItem(currentPage + 1, false, currentPage === totalPages, "&raquo;");
        html += `</ul></nav>`;
        $("#pagination").html(html);
    }

    function ThemVaoGio(id) {
        var formData = new FormData();
        formData.append('productId', id);
        formData.append('quantity', 1);
        $.ajax({
            type: "POST", url: url_domain + '/GioHang/ThemVaoGio', data: formData, contentType: false, processData: false,
            success: function (res) {
                if (res.indexOf("đăng nhập") !== -1) {
                    if (confirm("Cần đăng nhập để mua hàng. Đến trang đăng nhập?")) window.location.href = "/TaiKhoan/DangNhap";
                } else { alert(res); }
            },
            error: function () { alert("Lỗi thêm giỏ hàng."); }
        });
    }
</script>