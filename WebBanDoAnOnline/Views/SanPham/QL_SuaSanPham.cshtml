@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_QL_Layout.cshtml";
}

<main class="container-fluid py-4">
    <h3>Cập nhật thông tin sản phẩm</h3>
    <hr />
    <div class="card">
        <div class="card-body">
            <form id="form-update-sp" enctype="multipart/form-data">
                <input type="hidden" name="txt_MaSP_hide" value="@ViewBag.MaSP" />

                <div class="row">
                    <div class="col-md-8">
                        <!-- TÊN SẢN PHẨM -->
                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input type="text" id="txt_TenSP" class="form-control" name="txt_TenSP" />
                            <!-- Nơi hiển thị lỗi -->
                            <small id="err_TenSP" class="text-danger fw-bold"></small>
                        </div>

                        <div class="row">
                            <!-- GIÁ -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Giá (VND) <span class="text-danger">*</span></label>
                                <input type="number" id="txt_Gia" class="form-control" name="txt_Gia" />
                                <small id="err_Gia" class="text-danger fw-bold"></small>
                            </div>

                            <!-- DANH MỤC -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                                <select id="slc_MaDM" name="slc_MaDM" class="form-control">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <small id="err_MaDM" class="text-danger fw-bold"></small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select id="slc_TrangThai" name="slc_TrangThai" class="form-control">
                                <option value="Còn hàng">Còn hàng</option>
                                <option value="Hết hàng">Hết hàng</option>
                                <option value="Tạm ngưng">Tạm ngưng</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea id="txt_MoTa" name="txt_MoTa" class="form-control" rows="4"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ảnh sản phẩm</label>
                        <div class="mb-2">
                            <img id="img_preview" src="https://via.placeholder.com/250" class="img-thumbnail w-100" style="height: 250px; object-fit: cover;" />
                        </div>
                        <!-- Sửa lại tên hàm thành XemTruocAnh cho khớp với script -->
                        <input type="file" id="file_Anh" class="form-control" name="file_Anh" accept="image/*" onchange="XemTruocAnh(this)" />
                    </div>
                </div>
                <hr />
                <button type="button" id="btn_capnhat" class="btn btn-primary">Cập nhật</button>
                <a href="@Url.Action("QL_DanhSachSanPham", "SanPham" )" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</main>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    var baseUrl = '@Url.Content("~")';
    var maSP = '@ViewBag.MaSP';

    $(document).ready(function() {
        TaiDanhMuc();

        // Gán sự kiện click
        $("#btn_capnhat").click(function() {
            CapNhatSanPham();
        });

        // Xóa lỗi khi người dùng bắt đầu nhập lại
        $("input, select").on('input change', function() {
            $(this).next('small.text-danger').text('');
        });
    });

    function TaiDanhMuc() {
        $.ajax({
            url: '@Url.Action("Lay_DSDM", "DanhMuc")',
            type: 'POST',
            success: function(res) {
                // Kiểm tra nếu res là string JSON thì parse, nếu object thì dùng luôn
                var cats = (typeof res === 'string') ? JSON.parse(res) : res;
                var select = $("#slc_MaDM");
                select.empty();
                select.append('<option value="">-- Chọn danh mục --</option>');
                cats.forEach(c => {
                    select.append(`<option value="${c.MaDM}">${c.TenDM}</option>`);
                });
                TaiChiTietSanPham();
            },
            error: function() { console.log("Lỗi tải danh mục"); }
        });
    }

    function TaiChiTietSanPham() {
        $.post('@Url.Action("LayTTSP", "SanPham")', { id: maSP }, function (res) {
            if(res === "{}" || !res) { alert("Không tìm thấy sản phẩm!"); return; }

            var sp = (typeof res === 'string') ? JSON.parse(res) : res;

            $("#txt_TenSP").val(sp.TenSP);
            $("#txt_Gia").val(sp.Gia);
            $("#txt_MoTa").val(sp.MoTa);
            $("#slc_TrangThai").val(sp.TrangThai);
            $("#slc_MaDM").val(sp.MaDM);

            if (sp.Anh) {
                var imgPath = sp.Anh.replace('~/', '');
                $('#img_preview').attr('src', baseUrl + imgPath);
            }
        });
    }

    // --- HÀM VALIDATE VÀ CẬP NHẬT ---
    function CapNhatSanPham() {
        // 1. Reset thông báo lỗi cũ
        $("#err_TenSP").text("");
        $("#err_Gia").text("");
        $("#err_MaDM").text("");

        var isValid = true;

        // 2. Validate Tên sản phẩm
        var tenSP = $("#txt_TenSP").val().trim();
        if (tenSP === "") {
            $("#err_TenSP").text("Vui lòng nhập tên sản phẩm.");
            $("#txt_TenSP").focus();
            isValid = false;
        }

        // 3. Validate Giá
        var gia = $("#txt_Gia").val().trim();
        if (gia === "") {
            $("#err_Gia").text("Vui lòng nhập giá bán.");
            if(isValid) $("#txt_Gia").focus(); // Chỉ focus nếu chưa focus vào tên
            isValid = false;
        } else if (parseFloat(gia) <= 0) {
            $("#err_Gia").text("Giá bán phải lớn hơn 0.");
            isValid = false;
        }

        // 4. Validate Danh mục
        var maDM = $("#slc_MaDM").val();
        if (maDM === "" || maDM === null) {
            $("#err_MaDM").text("Vui lòng chọn danh mục.");
            isValid = false;
        }

        // Nếu có lỗi thì dừng lại, không gửi AJAX
        if (!isValid) return;

        // 5. Gửi dữ liệu khi đã hợp lệ
        var formData = new FormData($('#form-update-sp')[0]);

        $.ajax({
            type: "POST",
            url: '@Url.Action("CapNhatSanPham", "SanPham")',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                // Xử lý phản hồi từ server
                // Nếu server trả về chuỗi "Thành công" hoặc true
                if(res.toString().toLowerCase().includes("thành công") || res === true) {
                    alert("Cập nhật thành công!");
                    window.location.href = '@Url.Action("QL_DanhSachSanPham", "SanPham")';
                } else {
                    // Hiển thị lỗi từ server trả về (nếu có)
                    alert("Lỗi từ server: " + res);
                }
            },
            error: function(err) {
                alert("Lỗi kết nối: " + err.statusText);
            }
        });
    }

    function XemTruocAnh(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#img_preview').attr('src', e.target.result);
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>