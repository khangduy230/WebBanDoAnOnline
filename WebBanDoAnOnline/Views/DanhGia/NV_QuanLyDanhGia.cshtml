@{
    ViewBag.Title = "Tra cứu đánh giá";
    Layout = "~/Views/Shared/_NV_Layout.cshtml";
}

<style>
    /* General Styles */
    .danhgia-container {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: #ffffff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .danhgia-header h1 {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .danhgia-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 20px 0;
    }

    /* Search Box */
    .search-box {
        position: relative;
        flex-grow: 1;
    }

        .search-box input {
            width: 100%;
            padding: 10px 40px 10px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.2s;
        }

            .search-box input:focus {
                outline: none;
                border-color: #0d6efd;
            }

        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
        }

    /* Action Buttons */
    .action-btn {
        padding: 10px 18px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
        white-space: nowrap;
    }

    .btn-hide {
        background-color: #ffc107;
        color: #333;
    }

        .btn-hide:hover {
            background-color: #e0a800;
        }

    .btn-view-hidden {
        background-color: #6c757d;
        color: white;
    }

        .btn-view-hidden:hover {
            background-color: #5a6268;
        }

        .btn-view-hidden.active {
            background-color: #0d6efd;
        }

    /* Table Styles */
    .danhgia-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .danhgia-table th, .danhgia-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

        .danhgia-table th {
            font-weight: 600;
            color: #888;
            text-transform: uppercase;
            font-size: 12px;
        }

        .danhgia-table tr:last-child td {
            border-bottom: none;
        }

        .danhgia-table tr:hover {
            background-color: #f9f9f9;
        }

    /* Table Content */
    .customer-info, .product-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar, .product-img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid #eee;
    }

    .rating .stars {
        color: #ffc107;
    }

    .rating .rating-text {
        font-size: 12px;
        color: #777;
    }

    .comment-cell {
        max-width: 300px;
    }

    .comment-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .actions-cell a {
        color: #0d6efd;
        text-decoration: none;
        font-weight: 500;
        margin-right: 10px;
        cursor: pointer;
    }

        .actions-cell a:hover {
            text-decoration: underline;
        }
</style>

<div class="danhgia-container">
    <div class="danhgia-header">
        <h1>Tra cứu đánh giá</h1>
    </div>

    <div class="danhgia-actions">
        <div class="search-box">
            <input type="text" id="input-tim-kiem" placeholder="Tìm theo khách hàng, sản phẩm, bình luận...">
            <i class="fas fa-search"></i>
        </div>
        <button id="btn-an-chon" class="action-btn btn-hide">Ẩn đánh giá</button>
        <button id="btn-xem-an" class="action-btn btn-view-hidden">Xem đánh giá đã ẩn</button>
    </div>

    <table class="danhgia-table">
        <thead>
            <tr>
                <th><input type="checkbox" id="check-all"></th>
                <th>Khách hàng</th>
                <th>Sản phẩm</th>
                <th>Đánh giá</th>
                <th class="comment-cell">Bình luận</th>
                <th>Thời gian</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="tbody-danh-gia">
            <!-- Dữ liệu sẽ được render bằng JS -->
        </tbody>
    </table>
    <div id="loading-spinner" class="text-center p-5" style="display:none;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
</div>

@section scripts {
    <script>let dangXemDaAn = false;
    const urlDomain = window.location.origin;

    document.addEventListener('DOMContentLoaded', function () {
        taiDanhSachDanhGia();

        document.getElementById('input-tim-kiem').addEventListener('keyup', e => {
            if (e.key === 'Enter') taiDanhSachDanhGia();
        });

        document.getElementById('btn-xem-an').addEventListener('click', function () {
            dangXemDaAn = !dangXemDaAn;
            this.classList.toggle('active', dangXemDaAn);
            this.textContent = dangXemDaAn ? 'Xem đánh giá chưa ẩn' : 'Xem đánh giá đã ẩn';
            taiDanhSachDanhGia();
        });

        document.getElementById('check-all').addEventListener('change', function () {
            document.querySelectorAll('.check-item').forEach(chk => chk.checked = this.checked);
        });

        document.getElementById('btn-an-chon').addEventListener('click', () => xuLyHangLoat('an'));
    });

    async function fetchData(url, formData) {
        try {
            const response = await fetch(url, { method: 'POST', body: formData });
            if (!response.ok) throw new Error('Network response was not ok.');
            return await response.json();
        } catch (error) {
            console.error('Fetch error:', error);
            return { success: false, message: 'Lỗi kết nối đến server.' };
        }
    }

    async function taiDanhSachDanhGia() {
        const tuKhoa = document.getElementById('input-tim-kiem').value;
        const tbody = document.getElementById('tbody-danh-gia');
        const spinner = document.getElementById('loading-spinner');

        spinner.style.display = 'block';
        tbody.innerHTML = '';

        const formData = new FormData();
        formData.append('tuKhoa', tuKhoa);
        formData.append('trangThaiAn', dangXemDaAn ? 'da_an' : 'chua_an');

        const res = await fetchData(urlDomain + '/DanhGia/LayDanhSachDanhGia', formData);

        spinner.style.display = 'none';
        if (res.success) {
            renderDanhSach(res.data);
        } else {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger">Lỗi: ${res.message}</td></tr>`;
        }
    }

    function renderDanhSach(data) {
        const tbody = document.getElementById('tbody-danh-gia');
        if (!data || data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center p-5 text-muted">Không có đánh giá nào.</td></tr>';
            return;
        }

        tbody.innerHTML = data.map(dg => {
            const avatar = (dg.Avatar || '').replace('~', '') || '/img/default-avatar.png';
            const anhSP = (dg.AnhSanPham || '').replace('~', '') || '/img/no-image.jpg';
            const hanhDongAn = dg.DaAn ? `<a onclick="anHienDanhGia(${dg.MaDG})">Hủy ẩn</a>` : `<a onclick="anHienDanhGia(${dg.MaDG})">Ẩn</a>`;

            return `
                <tr>
                    <td><input type="checkbox" class="check-item" data-id="${dg.MaDG}"></td>
                    <td><div class="customer-info"><img src="${avatar}" class="avatar" alt="Avatar"><span>${dg.TenKhachHang}</span></div></td>
                    <td><div class="product-info"><img src="${anhSP}" class="product-img" alt="Sản phẩm"><span>${dg.TenSanPham}</span></div></td>
                    <td><div class="rating"><div class="stars">${taoSoSao(dg.SoSao)}</div><div class="rating-text">${nhanXetSao(dg.SoSao)}</div></div></td>
                    <td class="comment-cell">
                        <p class="comment-text" title="${dg.BinhLuan}">${dg.BinhLuan || 'Không có bình luận'}</p>
                        ${dg.PhanHoi ? `<p class="fst-italic text-muted small mt-1" title="Phản hồi: ${dg.PhanHoi}"><strong>QL:</strong> ${dg.PhanHoi}</p>` : ''}
                    </td>
                    <td>${dg.ThoiGian}</td>
                    <td class="actions-cell">${hanhDongAn}</td>
                </tr>
            `;
        }).join('');
    }

    function taoSoSao(soSao) {
        return Array.from({ length: 5 }, (_, i) =>
            `<i class="fa-${i < soSao ? 'solid' : 'regular'} fa-star"></i>`
        ).join('');
    }

    function nhanXetSao(soSao) {
        if (soSao >= 4) return 'Hài lòng';
        if (soSao === 3) return 'Bình thường';
        return 'Không hài lòng';
    }

    async function anHienDanhGia(maDG) {
        const hanhDong = dangXemDaAn ? 'hiện' : 'ẩn';
        if (!confirm(`Bạn có chắc muốn ${hanhDong} đánh giá này?`)) return;

        const formData = new FormData();
        formData.append('maDG', maDG);

        const data = await fetchData(urlDomain + '/DanhGia/ToggleAnDanhGia', formData);
        alert(data.message);
        if (data.success) taiDanhSachDanhGia();
    }

    async function xuLyHangLoat(hanhDong) {
        const ids = Array.from(document.querySelectorAll('.check-item:checked')).map(chk => chk.dataset.id);
        if (ids.length === 0) {
            alert('Vui lòng chọn ít nhất một đánh giá.');
            return;
        }

        const tenHanhDong = hanhDong === 'an' ? (dangXemDaAn ? 'hiện' : 'ẩn') : 'xóa';
        if (!confirm(`Bạn có chắc muốn ${tenHanhDong} ${ids.length} đánh giá đã chọn?`)) return;

        const url = '/DanhGia/ToggleAnDanhGia'; // Nhân viên chỉ có thể ẩn

        const promises = ids.map(id => {
            const formData = new FormData();
            formData.append('maDG', id);
            return fetchData(urlDomain + url, formData);
        });

        await Promise.all(promises);
        alert(`Đã ${tenHanhDong} các đánh giá đã chọn.`);
        taiDanhSachDanhGia();
    }</script>
}