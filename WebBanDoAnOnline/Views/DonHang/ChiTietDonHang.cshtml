@using WebBanDoAnOnline.Models
@{
    ViewBag.Title = "Chi tiết đơn hàng";

    // 1. Lấy thông tin tài khoản
    var user = Session["TaiKhoan"] as TaiKhoan;
    string userRole = "Khách hàng"; // Mặc định là Khách
    string backLink = "/CaiDat/DonMua"; // Mặc định quay về đơn mua của khách
    string layoutPage = "~/Views/Shared/_CaiDat_Layout.cshtml"; // Layout khách hàng

    if (user != null)
    {
        userRole = user.VaiTro ?? "Khách hàng";

        if (userRole == "Quản lý")
        {
            layoutPage = "~/Views/Shared/_QL_Layout.cshtml";
            backLink = Url.Action("QL_DanhSachDonHang", "DonHang");
        }
        else if (userRole == "Nhân viên")
        {
            layoutPage = "~/Views/Shared/_NV_Layout.cshtml";
            backLink = Url.Action("NV_DanhSachDonHang", "DonHang");
        }
        else
        {
            // Là Khách hàng
            layoutPage = "~/Views/Shared/_CaiDat_Layout.cshtml";
            backLink = "/CaiDat/DonMua";
        }
    }

    Layout = layoutPage;
    var serverId = ViewBag.MaDH;
}

<style>
    /* CSS CŨ GIỮ NGUYÊN - CHỈ THÊM CSS CHO NÚT HỦY CỦA KHÁCH */
    .od-Trang {
        max-width: 900px;
        margin: 0 auto 50px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .od-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        text-decoration: none;
        color: #555;
        font-weight: 600;
        transition: 0.2s;
    }

        .od-back:hover {
            color: #ffc107;
            transform: translateX(-5px);
        }

    .od-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
    }

    .od-steps {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 50px;
        margin-top: 20px;
        padding: 0 10px;
    }

    .od-step-track {
        position: absolute;
        top: 20px;
        left: 50px;
        right: 50px;
        height: 4px;
        background: #e9ecef;
        z-index: 0;
        border-radius: 4px;
    }

    .od-progress-active {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        background: #ffc107;
        z-index: 1;
        transition: width 0.5s ease;
        border-radius: 4px;
        width: 0%;
    }

    .od-step {
        position: relative;
        z-index: 2;
        text-align: center;
        width: 100px;
    }

    .dot {
        width: 44px;
        height: 44px;
        background: #e9ecef;
        color: #6c757d;
        border-radius: 50%;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        border: 4px solid #fff;
        transition: 0.3s;
    }

    .label {
        font-size: 13px;
        font-weight: 600;
        color: #adb5bd;
        line-height: 1.3;
    }

    .od-step.done .dot {
        background: #ffc107;
        color: #fff;
    }

    .od-step.done .label {
        color: #333;
    }

    .od-step.active .dot {
        background: #ffc107;
        color: #fff;
        transform: scale(1.1);
        box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.2);
    }

    .od-step.active .label {
        color: #ffc107;
        font-weight: 700;
    }

    .od-step[id="step-cancelled"].active .dot {
        background: #dc3545;
    }

    .od-step[id="step-cancelled"].active .label {
        color: #dc3545;
    }

    .hide {
        display: none !important;
    }

    @@media (max-width: 500px) {
        .od-step {
            width: auto;
            flex: 1;
        }

        .od-step-track {
            left: 15%;
            right: 15%;
            top: 16px;
        }

        .label {
            font-size: 11px;
        }

        .dot {
            width: 36px;
            height: 36px;
            font-size: 14px;
            border-width: 3px;
        }

        .od-card {
            padding: 20px;
        }
    }

    .od-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .od-meta {
            grid-template-columns: 1fr;
            gap: 30px;
        }
    }

    .od-group h5 {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 20px;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #f8f9fa;
        padding-bottom: 10px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .info-label {
        color: #6c757d;
    }

    .info-value {
        font-weight: 600;
        color: #212529;
        text-align: right;
    }

    .od-items {
        border-top: 1px dashed #dee2e6;
        padding-top: 20px;
        margin-bottom: 30px;
    }

    .od-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .od-item:last-child {
            border-bottom: none;
        }

    .item-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .item-img {
        width: 60px;
        height: 60px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid #eee;
    }

    .item-name {
        font-weight: 700;
        font-size: 15px;
        color: #333;
        margin-bottom: 2px;
    }

    .item-qty {
        font-size: 13px;
        color: #888;
        background: #f8f9fa;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .item-price {
        font-weight: 700;
        color: #333;
    }

    .od-footer {
        background: #fcfcfc;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #f0f0f0;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #e9ecef;
        font-size: 18px;
        font-weight: 800;
        color: #212529;
    }

    .total-val {
        color: #ffc107;
        font-size: 22px;
    }

    /* Buttons */
    .btn-group-action {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-accept {
        flex: 1;
        background: #ffc107;
        color: #000;
        border: none;
        padding: 10px;
        border-radius: 8px;
        font-weight: 700;
    }

    .btn-reject {
        flex: 1;
        background: #fff;
        color: #dc3545;
        border: 1px solid #dc3545;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-complete {
        width: 100%;
        background: #198754;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        margin-top: 15px;
    }

    /* Button Customer */
    .btn-cancel-cust {
        width: 100%;
        background: #fff;
        color: #dc3545;
        border: 1px solid #dc3545;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
        margin-top: 15px;
    }

        .btn-cancel-cust:hover {
            background: #dc3545;
            color: #fff;
        }

    .history-timeline {
        border-left: 2px solid #e9ecef;
        margin-left: 10px;
        padding-left: 25px;
        position: relative;
        margin-top: 15px;
    }

    .history-item {
        margin-bottom: 25px;
        position: relative;
    }

        .history-item::before {
            content: '';
            position: absolute;
            left: -31px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #adb5bd;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px #e9ecef;
        }

        .history-item:first-child::before {
            background: #ffc107;
            box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.2);
        }

    .h-time {
        font-size: 12px;
        color: #999;
        margin-bottom: 2px;
    }

    .h-content {
        font-size: 14px;
        color: #333;
    }

    .h-actor {
        font-weight: 700;
        color: #212529;
    }

    .h-note {
        background: #f8f9fa;
        padding: 8px 12px;
        border-radius: 6px;
        font-style: italic;
        color: #666;
        font-size: 13px;
        margin-top: 6px;
        border-left: 3px solid #dee2e6;
    }
</style>

<div class="od-Trang">
    <!-- Nút Back động -->
    <a href="@backLink" class="od-back">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>

    <div class="od-card">
        <!-- 1. STEPPER -->
        <div class="od-steps">
            <div class="od-step-track">
                <div class="od-progress-active" id="od-progress-active" style="width: 0%;"></div>
            </div>
            <div class="od-step" data-step="0">
                <div class="dot"><i class="fas fa-file-invoice"></i></div>
                <div class="label">Chờ xác nhận</div>
            </div>
            <div class="od-step" data-step="1">
                <div class="dot"><i class="fas fa-shipping-fast"></i></div>
                <div class="label">Đang giao</div>
            </div>
            <div class="od-step" data-step="2" id="step-completed">
                <div class="dot"><i class="fas fa-check"></i></div>
                <div class="label">Hoàn thành</div>
            </div>
            <div class="od-step hide" data-step="3" id="step-cancelled">
                <div class="dot"><i class="fas fa-times"></i></div>
                <div class="label">Đã hủy</div>
            </div>
        </div>

        <div class="od-meta">
            <!-- 2. THÔNG TIN ĐƠN -->
            <div class="od-group">
                <h5>Thông tin đơn hàng</h5>
                <div class="info-row"><span class="info-label">Mã đơn hàng</span> <span class="info-value text-primary" id="od-code">...</span></div>
                <div class="info-row"><span class="info-label">Ngày đặt hàng</span> <span class="info-value" id="od-time">...</span></div>
                <div class="info-row"><span class="info-label">Thanh toán</span> <span class="info-value badge bg-light text-dark border" id="od-pay">...</span></div>

                <!-- Khu vực nút hành động -->
                <!-- Chỉ hiển thị nếu KHÔNG phải Quản lý -->
                @if (userRole != "Quản lý")
                {
                    <div id="action-area"></div>
                }
                
            </div>

            <!-- 3. THÔNG TIN KHÁCH -->
            <div class="od-group">
                <h5>Thông tin nhận hàng</h5>
                <div class="info-row"><span class="info-label">Người nhận</span> <span class="info-value" id="od-cus-name">...</span></div>
                <div class="info-row"><span class="info-label">Điện thoại</span> <span class="info-value" id="od-cus-phone">...</span></div>
                <div class="info-row"><span class="info-label">Địa chỉ</span> <span class="info-value text-end" style="max-width: 220px;" id="od-cus-addr">...</span></div>
                <div class="info-row mt-3"><span class="info-label">Ghi chú</span> <span class="info-value text-danger fst-italic" id="od-note">Không có</span></div>
            </div>
        </div>

        <div class="od-group mb-4">
            <h5>Lịch sử xử lý & Trạng thái</h5>
            <div class="history-timeline" id="od-history-list">
                <div class="text-muted fst-italic">Đang tải lịch sử...</div>
            </div>
        </div>

        <!-- 4. DANH SÁCH -->
        <div class="od-group">
            <h5>Chi tiết sản phẩm</h5>
            <div class="od-items" id="od-items-list">
                <div class="text-center py-3 text-muted">Đang tải danh sách món...</div>
            </div>
        </div>

        <!-- 5. TỔNG TIỀN -->
        <div class="od-footer">
            <div class="info-row"><span class="info-label">Tổng tiền hàng</span> <span class="info-value" id="od-subtotal">0đ</span></div>
            <div class="info-row"><span class="info-label">Phí vận chuyển</span> <span class="info-value" id="od-ship-fee">0đ</span></div>
            <div class="info-row"><span class="info-label">Giảm giá</span> <span class="info-value text-success" id="od-discount">-0đ</span></div>
            <div class="total-row"><span>THÀNH TIỀN</span> <span class="total-val" id="od-total">0đ</span></div>
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    var url_domain = window.location.origin;
    var finalId = '@serverId';

    // TRUYỀN VAI TRÒ SANG JS
    var currentUserRole = '@userRole';

    function DinhDangTienTe(n) { return n.toLocaleString('vi-VN') + 'đ'; }

    $(document).ready(function() {
        if (!finalId || finalId == '0' || finalId == '') {
            const urlParams = new URLSearchParams(window.location.search);
            const idParam = urlParams.get('id');
            if (idParam) finalId = idParam;
        }

        if(!finalId || finalId == '0') {
            $("#od-items-list").html('<div class="text-center text-danger">Không tìm thấy mã đơn hàng.</div>');
            return;
        }

        var fd = new FormData();
        fd.append('id', finalId);

        $.ajax({
            type: "POST",
            url: url_domain + '/DonHang/LayChiTietDonHang',
            data: fd, processData: false, contentType: false,
            success: function(res) {
                var d = (typeof res === 'string') ? JSON.parse(res) : res;
                if(!d.id) { alert("Lỗi tải dữ liệu"); return; }

                $("#od-code").text("DH" + d.id.toString().padStart(5, '0'));
                $("#od-time").text(d.time);
                $("#od-pay").text(d.payMethod);
                $("#od-cus-name").text(d.cusName);
                $("#od-cus-phone").text(d.cusPhone);
                $("#od-cus-addr").text(d.cusAddr);
                if(d.note) $("#od-note").text(d.note);

                var hHtml = "";
                if (d.history && d.history.length > 0) {
                    d.history.forEach(h => {
                         var statusChange = "";
                        if (h.StatusOld) {
                            statusChange = `<span>${h.StatusOld}</span> <i class="fas fa-arrow-right mx-1 text-muted" style="font-size:10px"></i> <span class="fw-bold text-primary">${h.StatusNew}</span>`;
                        } else {
                            statusChange = `<span class="fw-bold text-primary">${h.StatusNew}</span>`;
                        }
                        hHtml += `
                        <div class="history-item">
                            <div class="h-time"><i class="far fa-clock me-1"></i> ${h.Time}</div>
                            <div class="h-content">
                                <span class="h-actor">${h.Actor}</span> đã cập nhật: ${statusChange}
                            </div>
                            ${h.Note ? `<div class="h-note">"${h.Note}"</div>` : ''}
                        </div>`;
                    });
                } else hHtml = '<div class="text-muted fst-italic py-2">Chưa có lịch sử.</div>';
                $("#od-history-list").html(hHtml);

                var html = "";
                if(d.items && d.items.length > 0) {
                    d.items.forEach(i => {
                        html += `
                        <div class="od-item">
                            <div class="item-left">
                                <img src="${i.image}" class="item-img" onerror="this.src='/img/no-image.jpg'">
                                <div>
                                    <div class="item-name">${i.name}</div>
                                    <div class="item-qty">x${i.qty}</div>
                                </div>
                            </div>
                            <div class="item-price">${DinhDangTienTe(i.price)}</div>
                        </div>`;
                    });
                }
                $("#od-items-list").html(html);

                $("#od-subtotal").text(DinhDangTienTe(d.subTotal));
                $("#od-ship-fee").text(DinhDangTienTe(d.shipFee));
                $("#od-discount").text("-" + DinhDangTienTe(d.discount));
                $("#od-total").text(DinhDangTienTe(d.total));

                CapNhatGiaoDien(d.statusText, d.id, d.status);
            }
        });
    });

    function CapNhatGiaoDien(statusText, id, statusKey) {
        var step = 0;
        if(statusKey === 'shipping') step = 1;
        if(statusKey === 'completed') step = 2;

        $(".od-step").removeClass("active done");

        if(statusKey === 'cancelled') {
            $("#step-completed").addClass("hide");
            $("#step-cancelled").removeClass("hide").addClass("active done");
            $("#od-progress-active").css({width: '100%', background: '#dc3545'});
            $(`[data-step='0']`).addClass("done");
            $(`[data-step='1']`).addClass("done");
        } else {
            var pct = (step / 2) * 100;
            $("#od-progress-active").css('width', pct + '%');
            for(let i=0; i<=step; i++) $(`[data-step='${i}']`).addClass("done");
            $(`[data-step='${step}']`).addClass("active");
        }

        // --- XỬ LÝ NÚT BẤM THEO VAI TRÒ ---
        var btnContainer = $("#action-area");
        if(btnContainer.length > 0) {
            var btnHtml = "";

            // A. NẾU LÀ NHÂN VIÊN
            if (currentUserRole === 'Nhân viên') {
                if(statusKey === 'pending') {
                    btnHtml = `
                    <div class="btn-group-action">
                        <button class="btn-accept" onclick="XuLyDonNV(${id}, 'accept')">Chấp nhận đơn</button>
                        <button class="btn-reject" onclick="TuChoiDonNV(${id})">Từ chối</button>
                    </div>`;
                } else if (statusKey === 'shipping') {
                    btnHtml = `<button class="btn-complete" onclick="XuLyDonNV(${id}, 'complete')"><i class="fas fa-check-circle me-2"></i> Xác nhận đã giao</button>`;
                }
            }
            // B. NẾU LÀ KHÁCH HÀNG (HOẶC VAI TRÒ KHÁC)
            else if (currentUserRole === 'Khách hàng') {
                if (statusKey === 'pending') {
                    // Nút hủy đơn cho khách hàng (Dùng API khác)
                    btnHtml = `<button class="btn-cancel-cust" onclick="HuyDonKhachHang(${id})">Hủy đơn hàng</button>`;
                } else if (statusKey === 'completed' || statusKey === 'cancelled') {
                     btnHtml = `<a href="/SanPham/KH_DanhSachSanPham" class="btn btn-warning w-100 mt-3 text-white fw-bold">Mua lại</a>`;
                }
            }

            btnContainer.html(btnHtml);
        }
    }

    // === HÀM XỬ LÝ CHO NHÂN VIÊN ===
    function XuLyDonNV(id, action, note='') {
        if(!confirm("Xác nhận thao tác?")) return;
        var fd = new FormData();
        fd.append('id', id);
        fd.append('action', action);
        fd.append('note', note);
        $.ajax({
            type: "POST", url: url_domain + '/DonHang/CapNhatTrangThai', // API của Nhân viên
            data: fd, processData: false, contentType: false,
            success: function(res) {
                if(res === "OK") { alert("Thành công!"); location.reload(); } else alert(res);
            }
        });
    }

    function TuChoiDonNV(id) {
        var reason = prompt("Nhập lý do từ chối:");
        if(reason && reason.trim() !== "") XuLyDonNV(id, 'reject', reason);
    }

    // === HÀM XỬ LÝ CHO KHÁCH HÀNG ===
    function HuyDonKhachHang(id) {
        if (!confirm('Bạn có chắc muốn hủy đơn hàng này?')) return;
        var fd = new FormData();
        fd.append('id', id);
        $.ajax({
            type: "POST",
            url: '/CaiDat/HuyDonHang', // API của Khách hàng
            data: fd, contentType: false, processData: false,
            success: function (res) {
                var r = (typeof res === 'string') ? JSON.parse(res) : res;
                alert(r.message);
                if (r.success) location.reload();
            }
        });
    }
</script>