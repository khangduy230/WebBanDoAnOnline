@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_QL_Layout.cshtml";
}

<style>
    .detail-page { padding: 16px; font-family: Arial, Helvetica, sans-serif; }
    .page-title { margin: 0 0 16px 0; font-size: 20px; font-weight: 600; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    .actions { display:flex; gap:8px; margin-bottom:12px; }
    .btn { height: 34px; padding: 6px 12px; border-radius: 6px; border: 1px solid #d1d5db; background:#fff; cursor:pointer; }
    .btn-primary { background:#2563eb; color:#fff; border-color:#1d4ed8; }
    .grid { display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:12px; }
    .item { display:flex; gap:8px; font-size:14px; }
    .item label { color:#6b7280; min-width:120px; }
    .status { display:inline-block; padding:4px 8px; border-radius: 999px; font-size:12px; border:1px solid transparent; }
    .status.pending { background:#fff7ed; color:#9a3412; border-color:#fdba74; }
    .status.confirmed { background:#ecfdf5; color:#065f46; border-color:#6ee7b7; }
    .status.shipping { background:#eff6ff; color:#1e40af; border-color:#93c5fd; }
    .status.completed { background:#f0fdf4; color:#166534; border-color:#86efac; }
    .status.cancelled { background:#fef2f2; color:#991b1b; border-color:#fecaca; }

    .items-table { width:100%; border-collapse:collapse; font-size:14px; }
    .items-table th, .items-table td { border-bottom:1px solid #e5e7eb; padding:8px; text-align:left; }
    .section-title { font-weight:600; margin:10px 0 6px; }
    @@media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
</style>

<div class="detail-page">
    <h2 class="page-title">Chi tiết đơn hàng</h2>

    <div class="actions">
        <a class="btn" href="/DonHang/QL_DanhSachDonHang">← Quay lại danh sách</a>
        <!-- Có thể thêm các nút xử lý đơn như Xác nhận, Hủy... khi tích hợp backend -->
    </div>

    <div class="card">
        <div class="grid">
            <div class="item"><label>Mã đơn:</label><div id="dMaDon"></div></div>
            <div class="item"><label>Ngày tạo:</label><div id="dNgayTao"></div></div>
            <div class="item"><label>Khách hàng:</label><div id="dKhachHang"></div></div>
            <div class="item"><label>SĐT:</label><div id="dSdt"></div></div>
            <div class="item"><label>Địa chỉ:</label><div id="dDiaChi"></div></div>
            <div class="item"><label>Trạng thái:</label><div id="dTrangThai"></div></div>
            <div class="item"><label>Tổng tiền:</label><div id="dTongTien"></div></div>
            <div class="item"><label>Ghi chú:</label><div id="dGhiChu"></div></div>
        </div>

        <div class="section-title">Sản phẩm trong đơn</div>
        <table class="items-table">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>SL</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody id="itemsTbody">
                <!-- Render bởi JS -->
            </tbody>
        </table>
    </div>
</div>

<script>
    // Dữ liệu mẫu giống với trang danh sách để demo (thay bằng dữ liệu server khi tích hợp)
    const ordersData = [
        {
            code: "DH0001",
            customerName: "Nguyễn Văn A",
            phone: "0901000001",
            address: "123 Trần Hưng Đạo, Q1, TP.HCM",
            createdAt: "2025-12-28",
            total: 250000,
            status: "pending",
            note: "Giao giờ hành chính",
            items: [
                { name: "Bánh mì thịt", qty: 2, price: 25000 },
                { name: "Trà sữa trân châu", qty: 1, price: 45000 }
            ]
        },
        {
            code: "DH0002",
            customerName: "Trần Thị B",
            phone: "0902000002",
            address: "55 Lê Lợi, Q1, TP.HCM",
            createdAt: "2025-12-29",
            total: 480000,
            status: "confirmed",
            note: "",
            items: [
                { name: "Phở bò", qty: 2, price: 60000 },
                { name: "Cà phê sữa", qty: 2, price: 35000 }
            ]
        },
        {
            code: "DH0003",
            customerName: "Lê Văn C",
            phone: "0903000003",
            address: "89 Nguyễn Huệ, Q1, TP.HCM",
            createdAt: "2025-12-30",
            total: 320000,
            status: "shipping",
            note: "Gọi trước khi giao",
            items: [
                { name: "Bún chả Hà Nội", qty: 2, price: 70000 },
                { name: "Nước cam", qty: 2, price: 40000 }
            ]
        },
        {
            code: "DH0004",
            customerName: "Phạm Thị D",
            phone: "0904000004",
            address: "12 Tôn Đức Thắng, Q1, TP.HCM",
            createdAt: "2025-12-31",
            total: 150000,
            status: "completed",
            note: "Khách thanh toán tiền mặt",
            items: [
                { name: "Cơm tấm", qty: 1, price: 45000 },
                { name: "Soda bạc hà", qty: 2, price: 30000 }
            ]
        },
        {
            code: "DH0005",
            customerName: "Đỗ Minh E",
            phone: "0905000005",
            address: "77 Pasteur, Q3, TP.HCM",
            createdAt: "2026-01-01",
            total: 0,
            status: "cancelled",
            note: "Khách hủy đơn",
            items: []
        }
    ];

    const formatCurrency = (v) => (v || 0).toLocaleString("vi-VN") + " ₫";
    const statusLabel = (s) => {
        switch (s) {
            case "pending": return '<span class="status pending">Chờ xử lý</span>';
            case "confirmed": return '<span class="status confirmed">Đã xác nhận</span>';
            case "shipping": return '<span class="status shipping">Đang giao</span>';
            case "completed": return '<span class="status completed">Hoàn thành</span>';
            case "cancelled": return '<span class="status cancelled">Đã hủy</span>';
            default: return s;
        }
    };

    function getQueryString(name) {
        const params = new URLSearchParams(window.location.search);
        return params.get(name);
    }

    function loadDetail() {
        const code = getQueryString("code"); // nhận từ link href trên trang danh sách
        if (!code) {
            alert("Thiếu mã đơn hàng (code).");
            return;
        }

        const order = ordersData.find(o => o.code === code);
        if (!order) {
            alert("Không tìm thấy đơn hàng " + code);
            return;
        }

        document.getElementById("dMaDon").textContent = order.code;
        document.getElementById("dNgayTao").textContent = order.createdAt;
        document.getElementById("dKhachHang").textContent = order.customerName;
        document.getElementById("dSdt").textContent = order.phone;
        document.getElementById("dDiaChi").textContent = order.address;
        document.getElementById("dTrangThai").innerHTML = statusLabel(order.status);
        document.getElementById("dTongTien").textContent = formatCurrency(order.total);
        document.getElementById("dGhiChu").textContent = order.note || "-";

        const itemsTbody = document.getElementById("itemsTbody");
        if (!order.items || order.items.length === 0) {
            itemsTbody.innerHTML = `<tr><td colspan="4" style="color:#6b7280;">Không có sản phẩm</td></tr>`;
        } else {
            itemsTbody.innerHTML = order.items.map(i => `
                <tr>
                    <td>${i.name}</td>
                    <td>${i.qty}</td>
                    <td>${formatCurrency(i.price)}</td>
                    <td>${formatCurrency(i.qty * i.price)}</td>
                </tr>
            `).join("");
        }
    }

    (function init() {
        loadDetail();
    })();
</script>