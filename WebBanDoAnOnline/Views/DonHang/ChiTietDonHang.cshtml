@using WebBanDoAnOnline.Models
@{
    ViewBag.Title = "Chi tiết đơn hàng";

    // 1. Lấy thông tin tài khoản và xác định quyền
    var user = Session["TaiKhoan"] as TaiKhoan;
    string userRole = "";
    string backLink = "#";
    string layoutPage = "~/Views/Shared/_NV_Layout.cshtml"; // Mặc định là NV

    if (user != null)
    {
        // Kiểm tra quyền (Tuỳ vào tên cột trong DB của bạn là Quyen hay VaiTro)
        // Ở đây giả định model TaiKhoan có thuộc tính Quyen
        userRole = user.VaiTro ?? "";

        if (userRole == "Quản lý" || userRole == "Admin")
        {
            layoutPage = "~/Views/Shared/_QL_Layout.cshtml";
            backLink = Url.Action("QL_DanhSachDonHang", "DonHang");
        }
        else // Nhân viên
        {
            layoutPage = "~/Views/Shared/_NV_Layout.cshtml";
            backLink = Url.Action("NV_DanhSachDonHang", "DonHang");
        }
    }

    Layout = layoutPage;

    // 2. Lấy ID đơn hàng từ Controller (đã được xử lý int)
    // Biến này quan trọng để JS gọi API
    var serverId = ViewBag.MaDH;
}

<style>
    .od-Trang {
        max-width: 900px;
        margin: 0 auto 50px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Back Button */
    .od-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        text-decoration: none;
        color: #555;
        font-weight: 600;
        transition: 0.2s;
    }

        .od-back:hover {
            color: #ffc107;
            transform: translateX(-5px);
        }

    .od-card {
        background: #fff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
    }

    /* --- STEPPER CSS --- */
    .od-steps {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 50px;
        margin-top: 20px;
        padding: 0 10px;
    }

    .od-step-track {
        position: absolute;
        top: 20px;
        left: 50px;
        right: 50px;
        height: 4px;
        background: #e9ecef;
        z-index: 0;
        border-radius: 4px;
    }

    .od-progress-active {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        background: #ffc107;
        z-index: 1;
        transition: width 0.5s ease;
        border-radius: 4px;
        width: 0%;
    }

    .od-step {
        position: relative;
        z-index: 2;
        text-align: center;
        width: 100px;
    }

    .dot {
        width: 44px;
        height: 44px;
        background: #e9ecef;
        color: #6c757d;
        border-radius: 50%;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
        border: 4px solid #fff;
        transition: 0.3s;
    }

    .label {
        font-size: 13px;
        font-weight: 600;
        color: #adb5bd;
        line-height: 1.3;
    }

    /* Active State */
    .od-step.done .dot {
        background: #ffc107;
        color: #fff;
    }

    .od-step.done .label {
        color: #333;
    }

    .od-step.active .dot {
        background: #ffc107;
        color: #fff;
        transform: scale(1.1);
        box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.2);
    }

    .od-step.active .label {
        color: #ffc107;
        font-weight: 700;
    }

    /* Cancelled State */
    .od-step[id="step-cancelled"].active .dot {
        background: #dc3545;
    }

    .od-step[id="step-cancelled"].active .label {
        color: #dc3545;
    }

    .hide {
        display: none !important;
    }

    /* Responsive */
    @@media (max-width: 500px) {
        .od-step {
            width: auto;
            flex: 1;
        }

        .od-step-track {
            left: 15%;
            right: 15%;
            top: 16px;
        }

        .label {
            font-size: 11px;
        }

        .dot {
            width: 36px;
            height: 36px;
            font-size: 14px;
            border-width: 3px;
        }

        .od-card {
            padding: 20px;
        }
    }

    /* INFO GRID */
    .od-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .od-meta {
            grid-template-columns: 1fr;
            gap: 30px;
        }
    }

    .od-group h5 {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 20px;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #f8f9fa;
        padding-bottom: 10px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .info-label {
        color: #6c757d;
    }

    .info-value {
        font-weight: 600;
        color: #212529;
        text-align: right;
    }

    /* ITEMS LIST */
    .od-items {
        border-top: 1px dashed #dee2e6;
        padding-top: 20px;
        margin-bottom: 30px;
    }

    .od-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .od-item:last-child {
            border-bottom: none;
        }

    .item-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .item-img {
        width: 60px;
        height: 60px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid #eee;
    }

    .item-name {
        font-weight: 700;
        font-size: 15px;
        color: #333;
        margin-bottom: 2px;
    }

    .item-qty {
        font-size: 13px;
        color: #888;
        background: #f8f9fa;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .item-price {
        font-weight: 700;
        color: #333;
    }

    /* FOOTER TOTAL */
    .od-footer {
        background: #fcfcfc;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #f0f0f0;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #e9ecef;
        font-size: 18px;
        font-weight: 800;
        color: #212529;
    }

    .total-val {
        color: #ffc107;
        font-size: 22px;
    }

    /* Buttons */
    .btn-group-action {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-accept {
        flex: 1;
        background: #ffc107;
        color: #000;
        border: none;
        padding: 10px;
        border-radius: 8px;
        font-weight: 700;
    }

    .btn-reject {
        flex: 1;
        background: #fff;
        color: #dc3545;
        border: 1px solid #dc3545;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-complete {
        width: 100%;
        background: #198754;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        margin-top: 15px;
    }
</style>

<div class="od-Trang">
    <!-- Nút Back động dựa trên Role -->
    <a href="@backLink" class="od-back">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách đơn hàng
    </a>

    <div class="od-card">
        <!-- 1. STEPPER -->
        <div class="od-steps">
            <div class="od-step-track">
                <div class="od-progress-active" id="od-progress-active" style="width: 0%;"></div>
            </div>
            <div class="od-step" data-step="0">
                <div class="dot"><i class="fas fa-file-invoice"></i></div>
                <div class="label">Chờ xác nhận</div>
            </div>
            <div class="od-step" data-step="1">
                <div class="dot"><i class="fas fa-shipping-fast"></i></div>
                <div class="label">Đang giao</div>
            </div>
            <div class="od-step" data-step="2" id="step-completed">
                <div class="dot"><i class="fas fa-check"></i></div>
                <div class="label">Hoàn thành</div>
            </div>
            <div class="od-step hide" data-step="3" id="step-cancelled">
                <div class="dot"><i class="fas fa-times"></i></div>
                <div class="label">Đã hủy</div>
            </div>
        </div>

        <div class="od-meta">
            <!-- 2. THÔNG TIN ĐƠN -->
            <div class="od-group">
                <h5>Thông tin đơn hàng</h5>
                <div class="info-row"><span class="info-label">Mã đơn hàng</span> <span class="info-value text-primary" id="od-code">...</span></div>
                <div class="info-row"><span class="info-label">Ngày đặt hàng</span> <span class="info-value" id="od-time">...</span></div>
                <div class="info-row"><span class="info-label">Thanh toán</span> <span class="info-value badge bg-light text-dark border" id="od-pay">...</span></div>

                <!-- Khu vực nút hành động -->
                <!-- Chỉ hiển thị nút xử lý nếu KHÔNG phải Quản lý (tức là Nhân viên) -->
                @if (userRole != "Quản lý" && userRole != "Admin")
                {
                    <div id="action-area"></div>
                }
                else
                {
                    <div class="mt-3 text-muted fst-italic text-end"><small>(Chế độ xem của Quản lý)</small></div>
                }
            </div>

            <!-- 3. THÔNG TIN KHÁCH -->
            <div class="od-group">
                <h5>Thông tin nhận hàng</h5>
                <div class="info-row"><span class="info-label">Người nhận</span> <span class="info-value" id="od-cus-name">...</span></div>
                <div class="info-row"><span class="info-label">Điện thoại</span> <span class="info-value" id="od-cus-phone">...</span></div>
                <div class="info-row"><span class="info-label">Địa chỉ</span> <span class="info-value text-end" style="max-width: 220px;" id="od-cus-addr">...</span></div>
                <div class="info-row mt-3"><span class="info-label">Ghi chú</span> <span class="info-value text-danger fst-italic" id="od-note">Không có</span></div>
            </div>
        </div>

        <!-- 4. DANH SÁCH -->
        <div class="od-group">
            <h5>Chi tiết sản phẩm</h5>
            <div class="od-items" id="od-items-list">
                <div class="text-center py-3 text-muted">Đang tải danh sách món...</div>
            </div>
        </div>

        <!-- 5. TỔNG TIỀN -->
        <div class="od-footer">
            <div class="info-row"><span class="info-label">Tổng tiền hàng</span> <span class="info-value" id="od-subtotal">0đ</span></div>
            <div class="info-row"><span class="info-label">Phí vận chuyển</span> <span class="info-value" id="od-ship-fee">0đ</span></div>
            <div class="info-row"><span class="info-label">Giảm giá</span> <span class="info-value text-success" id="od-discount">-0đ</span></div>
            <div class="total-row"><span>THÀNH TIỀN</span> <span class="total-val" id="od-total">0đ</span></div>
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    var url_domain = window.location.origin;

    // 1. Lấy ID đơn hàng từ ViewBag (Đã được Controller xử lý thành số int)
    // Nếu ViewBag rỗng thì serverId sẽ là chuỗi rỗng
    var finalId = '@serverId';

    function DinhDangTienTe(n) { return n.toLocaleString('vi-VN') + 'đ'; }

    $(document).ready(function() {

        // Logic dự phòng: Nếu vì lý do nào đó ViewBag không lấy được, thử phân tích URL
        if (!finalId || finalId == '0' || finalId == '') {
            const urlParams = new URLSearchParams(window.location.search);
            const codeParam = urlParams.get('code');
            const idParam = urlParams.get('id');

            if (idParam) finalId = idParam;
            else if (codeParam) finalId = codeParam.toUpperCase().replace("DH", "");
        }

        // Nếu vẫn không có ID thì dừng
        if(!finalId || finalId == '0') {
            console.error("Không tìm thấy mã đơn hàng (ID)");
            $("#od-items-list").html('<div class="text-center text-danger">Không tìm thấy mã đơn hàng.</div>');
            return;
        }

        console.log("Đang lấy chi tiết cho ID:", finalId);

        // Gọi API
        var fd = new FormData();
        fd.append('id', finalId);

        $.ajax({
            type: "POST",
            url: url_domain + '/DonHang/LayChiTietDonHang',
            data: fd, processData: false, contentType: false,
            success: function(res) {
                // Parse JSON nếu server trả về chuỗi
                var d = (typeof res === 'string') ? JSON.parse(res) : res;

                if(!d.id) {
                    alert("Không tìm thấy dữ liệu đơn hàng trong hệ thống.");
                    return;
                }

                // 1. Bind thông tin text
                // Hiển thị mã đơn dạng DH0000x cho đẹp
                $("#od-code").text("DH" + d.id.toString().padStart(5, '0'));
                $("#od-time").text(d.time);
                $("#od-pay").text(d.payMethod);

                $("#od-cus-name").text(d.cusName);
                $("#od-cus-phone").text(d.cusPhone);
                $("#od-cus-addr").text(d.cusAddr);
                if(d.note) $("#od-note").text(d.note);

                // 2. Render danh sách món ăn
                var html = "";
                if(d.items && d.items.length > 0) {
                    d.items.forEach(i => {
                        html += `
                        <div class="od-item">
                            <div class="item-left">
                                <img src="${i.image}" class="item-img" onerror="this.src='/img/no-image.jpg'">
                                <div>
                                    <div class="item-name">${i.name}</div>
                                    <div class="item-qty">x${i.qty}</div>
                                </div>
                            </div>
                            <div class="item-price">${DinhDangTienTe(i.price)}</div>
                        </div>`;
                    });
                } else {
                    html = '<div class="text-center py-3">Không có sản phẩm nào.</div>';
                }
                $("#od-items-list").html(html);

                // 3. Bind tiền tệ
                $("#od-subtotal").text(DinhDangTienTe(d.subTotal));
                $("#od-ship-fee").text(DinhDangTienTe(d.shipFee));
                $("#od-discount").text("-" + DinhDangTienTe(d.discount));
                $("#od-total").text(DinhDangTienTe(d.total));

                // 4. Cập nhật trạng thái (Thanh tiến trình & Nút bấm)
                CapNhatGiaoDien(d.statusText, d.id, d.status);
            },
            error: function() {
                alert("Lỗi kết nối khi tải chi tiết đơn hàng.");
            }
        });
    });

    function CapNhatGiaoDien(statusText, id, statusKey) {
        // Map statusKey (pending, shipping...) sang Step Index
        var step = 0;
        if(statusKey === 'shipping') step = 1;
        if(statusKey === 'completed') step = 2;

        // Reset class
        $(".od-step").removeClass("active done");

        if(statusKey === 'cancelled') {
            // Trường hợp hủy
            $("#step-completed").addClass("hide");
            $("#step-cancelled").removeClass("hide").addClass("active done");
            $("#od-progress-active").css({width: '100%', background: '#dc3545'});

            // Các bước trước đó cho thành màu xám (done)
            $(`[data-step='0']`).addClass("done");
            $(`[data-step='1']`).addClass("done");
        } else {
            // Trường hợp bình thường
            var pct = (step / 2) * 100;
            $("#od-progress-active").css('width', pct + '%');

            // Highlight các bước đã qua
            for(let i=0; i<=step; i++) $(`[data-step='${i}']`).addClass("done");
            // Active bước hiện tại
            $(`[data-step='${step}']`).addClass("active");
        }

        // Render Buttons (Chỉ hiển thị nếu div action-area tồn tại - tức là Nhân viên)
        var btnContainer = $("#action-area");
        if(btnContainer.length > 0) {
            var btnHtml = "";
            if(statusKey === 'pending') {
                btnHtml = `
                <div class="btn-group-action">
                    <button class="btn-accept" onclick="XuLyDon(${id}, 'accept')">Chấp nhận đơn</button>
                    <button class="btn-reject" onclick="TuChoiDon(${id})">Từ chối</button>
                </div>`;
            } else if (statusKey === 'shipping') {
                btnHtml = `<button class="btn-complete" onclick="XuLyDon(${id}, 'complete')"><i class="fas fa-check-circle me-2"></i> Xác nhận đã giao</button>`;
            }
            btnContainer.html(btnHtml);
        }
    }

    function XuLyDon(id, action, note='') {
        var msg = "Bạn chắc chắn muốn thực hiện hành động này?";
        if(action === 'complete') msg = "Xác nhận đơn hàng đã giao thành công và thu tiền?";
        if(action === 'accept') msg = "Chấp nhận chuẩn bị món cho đơn hàng này?";

        if(!confirm(msg)) return;

        var fd = new FormData();
        fd.append('id', id);
        fd.append('action', action);
        fd.append('note', note);

        // Gọi API cập nhật trạng thái
        $.ajax({
            type: "POST",
            url: url_domain + '/DonHang/CapNhatTrangThai',
            data: fd, processData: false, contentType: false,
            success: function(res) {
                if(res === "OK") {
                    alert("Cập nhật thành công!");
                    location.reload();
                }
                else alert(res);
            },
            error: function() { alert("Lỗi kết nối server"); }
        });
    }

    function TuChoiDon(id) {
        var reason = prompt("Nhập lý do từ chối (Hết hàng, v.v...):");
        if(reason !== null) {
            if(reason.trim() === "") alert("Vui lòng nhập lý do để khách hàng biết.");
            else XuLyDon(id, 'reject', reason);
        }
    }
</script>