@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_QL_Layout.cshtml";
}

<style>
    .orders-page { padding: 16px; font-family: Arial, Helvetica, sans-serif; }
    .page-title { margin: 0 0 16px 0; font-size: 20px; font-weight: 600; }
    .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }

    .toolbar { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr auto; gap: 8px; margin-bottom: 12px; align-items: end; }
    .form-field { display: flex; flex-direction: column; gap: 6px; }
    .form-field label { font-size: 12px; color: #374151; }
    .form-input, .form-select { height: 34px; border: 1px solid #d1d5db; border-radius: 6px; padding: 6px 10px; font-size: 14px; }
    .btn { height: 34px; padding: 6px 12px; border-radius: 6px; border: 1px solid transparent; font-size: 14px; cursor: pointer; }
    .btn-primary { background: #2563eb; color: #fff; border-color: #1d4ed8; }
    .btn-secondary { background: #f3f4f6; color: #111827; border-color: #e5e7eb; }

    .orders-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .orders-table th, .orders-table td { border-bottom: 1px solid #e5e7eb; padding: 10px 8px; text-align: left; }
    .orders-table th { background: #f9fafb; font-weight: 600; color: #374151; }

    .status { display: inline-block; padding: 4px 8px; border-radius: 999px; font-size: 12px; border: 1px solid transparent; }
    .status.pending { background: #fff7ed; color: #9a3412; border-color: #fdba74; }
    .status.confirmed { background: #ecfdf5; color: #065f46; border-color: #6ee7b7; }
    .status.shipping { background: #eff6ff; color: #1e40af; border-color: #93c5fd; }
    .status.completed { background: #f0fdf4; color: #166534; border-color: #86efac; }
    .status.cancelled { background: #fef2f2; color: #991b1b; border-color: #fecaca; }

    .pagination { display: flex; justify-content: flex-end; gap: 6px; margin-top: 12px; }
    .page-btn { min-width: 34px; height: 34px; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; cursor: pointer; }
    .page-btn.active { background: #2563eb; color: #fff; border-color: #1d4ed8; }

    @@media (max-width: 768px) {
        .toolbar { grid-template-columns: 1fr 1fr; }
    }
</style>

<div class="orders-page">
    <h2 class="page-title">Quản lý đơn hàng</h2>

    <div class="card">
        <!-- Thanh công cụ tìm kiếm / lọc -->
        <div class="toolbar">
            <div class="form-field">
                <label for="searchKeyword">Tìm kiếm (Mã đơn / Khách hàng / SĐT)</label>
                <input id="searchKeyword" class="form-input" type="text" placeholder="VD: DH000123, Nguyễn Văn A, 0901..." />
            </div>

            <div class="form-field">
                <label for="statusFilter">Trạng thái</label>
                <select id="statusFilter" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="pending">Chờ xử lý</option>
                    <option value="confirmed">Đã xác nhận</option>
                    <option value="shipping">Đang giao</option>
                    <option value="completed">Hoàn thành</option>
                    <option value="cancelled">Đã hủy</option>
                </select>
            </div>

            <div class="form-field">
                <label for="dateFrom">Ngày từ</label>
                <input id="dateFrom" class="form-input" type="date" />
            </div>

            <div class="form-field">
                <label for="dateTo">Ngày đến</label>
                <input id="dateTo" class="form-input" type="date" />
            </div>

            <div class="form-field" style="display:flex; gap:8px;">
                <button id="btnSearch" class="btn btn-primary">Tìm kiếm</button>
                <button id="btnReset" class="btn btn-secondary">Làm mới</button>
            </div>
        </div>

        <!-- Bảng danh sách đơn hàng -->
        <table class="orders-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>SĐT</th>
                    <th>Ngày tạo</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="ordersTbody">
                <!-- Render bởi JS -->
            </tbody>
        </table>

        <!-- Phân trang -->
        <div class="pagination" id="pagination"></div>
    </div>
</div>

<script>
    // Dữ liệu mẫu (thay bằng dữ liệu thật từ server khi tích hợp)
    const ordersData = [
        { id: 1, code: "DH0001", customerName: "Nguyễn Văn A", phone: "0901000001", createdAt: "2025-12-28", total: 250000, status: "pending" },
        { id: 2, code: "DH0002", customerName: "Trần Thị B", phone: "0902000002", createdAt: "2025-12-29", total: 480000, status: "confirmed" },
        { id: 3, code: "DH0003", customerName: "Lê Văn C", phone: "0903000003", createdAt: "2025-12-30", total: 320000, status: "shipping" },
        { id: 4, code: "DH0004", customerName: "Phạm Thị D", phone: "0904000004", createdAt: "2025-12-31", total: 150000, status: "completed" },
        { id: 5, code: "DH0005", customerName: "Đỗ Minh E", phone: "0905000005", createdAt: "2026-01-01", total: 0, status: "cancelled" }
    ];

    const pageSize = 10;
    let filtered = [...ordersData];
    let currentPage = 1;

    const formatCurrency = (v) => (v || 0).toLocaleString("vi-VN") + " ₫";
    const statusLabel = (s) => {
        switch (s) {
            case "pending": return '<span class="status pending">Chờ xử lý</span>';
            case "confirmed": return '<span class="status confirmed">Đã xác nhận</span>';
            case "shipping": return '<span class="status shipping">Đang giao</span>';
            case "completed": return '<span class="status completed">Hoàn thành</span>';
            case "cancelled": return '<span class="status cancelled">Đã hủy</span>';
            default: return s;
        }
    };

    const inDateRange = (dateStr, fromStr, toStr) => {
        const d = new Date(dateStr);
        if (fromStr) {
            const f = new Date(fromStr);
            if (d < new Date(f.getFullYear(), f.getMonth(), f.getDate())) return false;
        }
        if (toStr) {
            const t = new Date(toStr);
            const end = new Date(t.getFullYear(), t.getMonth(), t.getDate(), 23, 59, 59, 999);
            if (d > end) return false;
        }
        return true;
    };

    function renderTable() {
        const tbody = document.getElementById("ordersTbody");
        tbody.innerHTML = "";

        const start = (currentPage - 1) * pageSize;
        const pageItems = filtered.slice(start, start + pageSize);

        if (pageItems.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#6b7280;">Không có dữ liệu</td></tr>`;
            renderPagination();
            return;
        }

        const rows = pageItems.map(o => `
            <tr>
                <td><a href="/DonHang/ChiTietDonHang?code=${encodeURIComponent(o.code)}" title="Xem chi tiết">${o.code}</a></td>
                <td>${o.customerName}</td>
                <td>${o.phone}</td>
                <td>${o.createdAt}</td>
                <td>${formatCurrency(o.total)}</td>
                <td>${statusLabel(o.status)}</td>
                <td>
                    <a class="btn btn-secondary" href="/DonHang/ChiTietDonHang?code=${encodeURIComponent(o.code)}">Xem chi tiết</a>
                </td>
            </tr>
        `).join("");

        tbody.innerHTML = rows;
        renderPagination();
    }

    function renderPagination() {
        const pag = document.getElementById("pagination");
        pag.innerHTML = "";
        const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));

        const makeBtn = (text, page, disabled = false, active = false) => {
            const btn = document.createElement("button");
            btn.className = "page-btn" + (active ? " active" : "");
            btn.textContent = text;
            if (disabled) btn.disabled = true;
            btn.addEventListener("click", () => { currentPage = page; renderTable(); });
            return btn;
        };

        pag.appendChild(makeBtn("«", 1, currentPage === 1));
        pag.appendChild(makeBtn("‹", Math.max(1, currentPage - 1), currentPage === 1));

        const totalPagesToShow = 5;
        const start = Math.max(1, currentPage - 2);
        const end = Math.min(totalPages, start + totalPagesToShow - 1);
        for (let p = start; p <= end; p++) pag.appendChild(makeBtn(String(p), p, false, p === currentPage));

        pag.appendChild(makeBtn("›", Math.min(totalPages, currentPage + 1), currentPage === totalPages));
        pag.appendChild(makeBtn("»", totalPages, currentPage === totalPages));
    }

    function applyFilter() {
        const keyword = document.getElementById("searchKeyword").value.trim().toLowerCase();
        const status = document.getElementById("statusFilter").value;
        const from = document.getElementById("dateFrom").value;
        const to = document.getElementById("dateTo").value;

        filtered = ordersData.filter(o => {
            const kwMatch = !keyword ||
                o.code.toLowerCase().includes(keyword) ||
                o.customerName.toLowerCase().includes(keyword) ||
                o.phone.toLowerCase().includes(keyword);
            const statusMatch = !status || o.status === status;
            const dateMatch = inDateRange(o.createdAt, from, to);
            return kwMatch && statusMatch && dateMatch;
        });

        currentPage = 1;
        renderTable();
    }

    function resetFilter() {
        document.getElementById("searchKeyword").value = "";
        document.getElementById("statusFilter").value = "";
        document.getElementById("dateFrom").value = "";
        document.getElementById("dateTo").value = "";
        filtered = [...ordersData];
        currentPage = 1;
        renderTable();
    }

    (function init() {
        document.getElementById("btnSearch").addEventListener("click", applyFilter);
        document.getElementById("btnReset").addEventListener("click", resetFilter);
        document.getElementById("searchKeyword").addEventListener("keydown", (e) => { if (e.key === "Enter") applyFilter(); });
        renderTable();
    })();
</script> 