@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_KH_Layout.cshtml"; 
}

<!-- 1. HERO SECTION -->
<section class="hero-section py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-heading fw-bold display-4 mb-3">
                    Dinh dưỡng tận nơi <br />
                    <span class="text-warning">Thảnh thơi sống khỏe.</span>
                </h1>
                <p class="hero-subheading lead text-muted">
                    Hệ thống đặt món ăn trực tuyến FuTho Food. Hương vị đậm đà, giao hàng nhanh chóng.
                </p>
                <a href="#featured-food" class="btn btn-warning btn-lg rounded-pill fw-bold text-white px-4">Đặt món ngay</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0 text-center">
                <img src="~/img/banner.png" alt="Banner" class="img-fluid rounded shadow-lg" style="max-height: 400px;"
                     onerror="this.style.display='none'" /> <!-- Ẩn nếu ko có ảnh banner -->
            </div>
        </div>
    </div>
</section>

<!-- 2. DANH SÁCH SẢN PHẨM -->
<section id="featured-food" class="featured-section py-5 container">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2 class="section-title fw-bold text-dark">Món ăn nổi bật</h2>
        <a href="/SanPham/KH_DanhSachSanPham" class="btn btn-outline-dark rounded-pill btn-sm">Xem tất cả <i class="fas fa-arrow-right"></i></a>
    </div>

    <!-- Container chứa sản phẩm -->
    <div id="ds_sanpham" class="row g-4">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <div class="mt-2 text-muted">Đang tải món ngon...</div>
        </div>
    </div>
</section>

<!-- 3. JAVASCRIPT XỬ LÝ -->
<script>
    // Hàm định dạng tiền tệ
    function DinhDangTienTe(n) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
    }

    // Lấy đúng domain gốc
    var url_domain = window.location.origin;

    $(document).ready(function () {
        $.ajax({
            type: "POST",
            url: url_domain + '/KH_TrangChu/LaySanPhamTrangChu',
            contentType: false, processData: false, cache: false,
            success: function (response) {
                // Parse dữ liệu
                var dssp = (typeof response === 'string') ? JSON.parse(response) : response;
                var div_show = $("#ds_sanpham");
                var html_str = "";

                if (!dssp || dssp.length === 0) {
                    div_show.html('<div class="col-12 text-center text-muted">Chưa có sản phẩm nào.</div>');
                    return;
                }

                dssp.forEach(function (sp) {
                    // Xử lý đường dẫn ảnh
                    var imgUrl = sp.Anh ? sp.Anh.replace('~', '') : '/img/no-image.jpg';

                    // Xử lý hiển thị sao 
                    var starDisplay = sp.SoSao > 0
                        ? `<i class="fas fa-star text-warning"></i> ${sp.SoSao}`
                        : `<span class="fas fa-star text-warning"></span> 0`;

                    html_str += `
                    <div class="col-lg-3 col-md-4 col-6">
                        <div class="card h-100 border-0 shadow-sm product-card">
                            <div class="position-relative overflow-hidden rounded-top">
                                <a href="/SanPham/ChiTietSanPham?maSP=${sp.MaSP}">
                                    <img src="${imgUrl}" class="card-img-top" style="height: 200px; object-fit: cover;"
                                         onerror="this.src='/Content/img/no-image.jpg'">
                                </a>
                            </div>
                            <div class="card-body d-flex flex-column p-3">
                                <h5 class="card-title text-truncate mb-1">
                                    <a href="/SanPham/ChiTietSanPham?maSP=${sp.MaSP}" class="text-decoration-none text-dark fw-bold" title="${sp.TenSP}">${sp.TenSP}</a>
                                </h5>

                                <div class="mt-auto pt-2">
                                    <div class="mb-2 fw-bold text-dark fs-5">${DinhDangTienTe(sp.GiaGoc)}</div>

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span>${starDisplay}</span>
                                    </div>

                                    <button class="btn btn-warning w-100 fw-bold shadow-sm btn-hover-effect" onclick="ThemVaoGio(${sp.MaSP})">
                                        <i class="fas fa-cart-plus"></i> Thêm
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>`;
                });

                div_show.html(html_str);
            },
            error: function (err) {
                console.log(err);
                $("#ds_sanpham").html('<div class="col-12 text-center text-danger">Lỗi tải dữ liệu server.</div>');
            }
        });
    });

    // Hàm thêm vào giỏ (Giả định bạn đã có Controller GioHang)
    function ThemVaoGio(id) {
        var formData = new FormData();
        formData.append('productId', id);
        formData.append('quantity', 1);
        $.ajax({
            type: "POST", url: url_domain + '/GioHang/ThemVaoGio', data: formData, contentType: false, processData: false,
            success: function (res) {
                if (res.indexOf("đăng nhập") !== -1) {
                    if (confirm("Cần đăng nhập để mua hàng. Đến trang đăng nhập?")) window.location.href = "/TaiKhoan/DangNhap";
                } else { alert(res); }
            },
            error: function () { alert("Lỗi hệ thống."); }
        });
    }
</script>

<style>
    .product-card {
        transition: transform 0.3s, box-shadow 0.3s;
        border-radius: 12px;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
        }

    .btn-hover-effect:hover {
        background-color: #ffca2c;
        transform: scale(1.02);
    }
</style>