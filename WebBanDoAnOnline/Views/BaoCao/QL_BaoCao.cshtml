﻿@{
    ViewBag.Title = "Báo cáo";
    Layout = "~/Views/Shared/_QL_Layout.cshtml";

}

<style>
    .wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px;
        font-family: Segoe UI, Tahoma, Arial, sans-serif;
    }

    .h1 {
        font-size: 22px;
        font-weight: 700;
        color: #333;
        margin-bottom: 12px;
    }

    .hang {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 12px;
    }

    .o {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 12px;
        flex: 1;
        min-width: 220px;
    }

    .nhan {
        color: #666;
        font-size: 12px;
        text-transform: uppercase;
    }

    .gt {
        font-size: 20px;
        font-weight: 700;
        color: #111;
        margin-top: 6px;
    }

    .bo-loc {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .inp {
        padding: 6px 8px;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

    .btn {
        padding: 7px 12px;
        border: 1px solid #111;
        background: #111;
        color: #fff;
        border-radius: 6px;
        cursor: pointer;
    }

        .btn:hover {
            opacity: .9;
        }

    .bang {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .bang th, .bang td {
            border: 1px solid #eee;
            padding: 8px;
            text-align: left;
        }

        .bang th {
            background: #f7f7f7;
            color: #444;
        }

    .nhom {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 12px;
    }

    .tieu-de-nhom {
        font-weight: 700;
        color: #333;
        margin-bottom: 8px;
    }

    .thanh {
        height: 8px;
        background: #eee;
        border-radius: 999px;
        overflow: hidden;
    }

    .fill {
        height: 100%;
        background: #4caf50;
    }

    .note {
        color: #888;
        font-size: 12px;
    }
</style>

<div class="wrap">
    <div class="h1">Báo cáo</div>

    <div class="hang">
        <div class="o" style="flex:2">
            <div class="bo-loc">
                <span>Từ</span>
                <input class="inp" type="date" id="tuNgay" />
                <span>đến</span>
                <input class="inp" type="date" id="denNgay" />
                <button class="btn" id="btnTai">Tải báo cáo</button>
                <span class="note" id="lblKhoang"></span>
            </div>
        </div>
    </div>

    <div class="hang">
        <div class="o"><div class="nhan">Tổng đơn</div><div class="gt" id="kpiTongDon">0</div></div>
        <div class="o"><div class="nhan">Đã giao</div><div class="gt" id="kpiDaGiao">0</div></div>
        <div class="o"><div class="nhan">Đã hủy</div><div class="gt" id="kpiDaHuy">0</div></div>
        <div class="o"><div class="nhan">Doanh thu</div><div class="gt" id="kpiDoanhThu">0</div></div>
    </div>

    <div class="hang">
        <div class="nhom" style="flex:1">
            <div class="tieu-de-nhom">Top sản phẩm (theo số lượng)</div>
            <table class="bang" id="tbTopSP">
                <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Doanh thu</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="nhom" style="flex:1">
            <div class="tieu-de-nhom">Doanh thu theo danh mục</div>
            <table class="bang" id="tbDM">
                <thead><tr><th>Danh mục</th><th>Doanh thu</th><th style="width:40%">Tỉ trọng</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <div class="hang">
        <div class="nhom" style="flex:1">
            <div class="tieu-de-nhom">Voucher đang sử dụng</div>
            <table class="bang" id="tbVoucher">
                <thead><tr><th>Voucher</th><th>Số đơn</th><th>Doanh thu</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <script>
        (function () {
            var goc = window.location.origin;

            function dinhDangSo(n) {
                n = Number(n || 0);
                return n.toLocaleString('vi-VN');
            }

            function macDinhNgay() {
                var d = new Date();
                var y = d.getFullYear(); var m = d.getMonth() + 1; var day = d.getDate();
                function pad(x) { return x < 10 ? '0' + x : '' + x; }
                // Mặc định từ đầu tháng đến hiện tại
                document.getElementById('tuNgay').value = y + '-' + pad(m) + '-01';
                document.getElementById('denNgay').value = y + '-' + pad(m) + '-' + pad(day);
            }

            function taiBaoCao() {
                var tu = document.getElementById('tuNgay').value;
                var den = document.getElementById('denNgay').value;

                // --- BẮT ĐẦU VALIDATE ---
                // 1. Kiểm tra rỗng
                if (!tu || !den) {
                    alert('Vui lòng chọn đầy đủ "Từ ngày" và "Đến ngày".');
                    return;
                }

                // 2. Kiểm tra logic (Ngày bắt đầu > Ngày kết thúc)
                var dateTu = new Date(tu);
                var dateDen = new Date(den);

                if (dateTu > dateDen) {
                    alert('Ngày bắt đầu không được lớn hơn ngày kết thúc.');
                    // Reset lại ngày kết thúc bằng ngày bắt đầu (gợi ý cho user)
                    document.getElementById('denNgay').value = tu;
                    return;
                }
                // --- KẾT THÚC VALIDATE ---

                var form = new FormData();
                form.append('tuNgay', tu);
                form.append('denNgay', den);

                // Hiệu ứng đang tải (Optional: Có thể thêm spinner nếu muốn)
                var btn = document.getElementById('btnTai');
                var textCu = btn.innerText;
                btn.innerText = 'Đang tải...';
                btn.disabled = true;

                fetch(goc + '/BaoCao/Lay_BaoCao', { method: 'POST', body: form })
                    .then(r => r.text())
                    .then(tx => {
                        var res = typeof tx === 'string' ? JSON.parse(tx) : tx;
                        if (!res.success) { alert(res.message || 'Lỗi'); return; }
                        veBaoCao(res.data);
                    })
                    .catch(e => alert('Lỗi tải báo cáo: ' + e))
                    .finally(() => {
                        // Trả lại trạng thái nút
                        btn.innerText = textCu;
                        btn.disabled = false;
                    });
            }

            function veBaoCao(d) {
                // Khoảng TG
                document.getElementById('lblKhoang').innerText = ' (' + d.KhoangThoiGian.Tu + ' - ' + d.KhoangThoiGian.Den + ')';

                // KPI
                document.getElementById('kpiTongDon').innerText = dinhDangSo(d.TongQuan.TongDon);
                document.getElementById('kpiDaGiao').innerText = dinhDangSo(d.TongQuan.DaGiao);
                document.getElementById('kpiDaHuy').innerText = dinhDangSo(d.TongQuan.DaHuy);
                document.getElementById('kpiDoanhThu').innerText = dinhDangSo(d.TongQuan.DoanhThu) + 'đ';

                // Top SP
                var spBody = document.querySelector('#tbTopSP tbody');
                spBody.innerHTML = '';
                if (d.TopSanPham && d.TopSanPham.length) {
                    d.TopSanPham.forEach(x => {
                        var tr = document.createElement('tr');
                        tr.innerHTML = '<td>' + (x.TenSP || 'Sản phẩm') + '</td>' +
                            '<td>' + dinhDangSo(x.SoLuong) + '</td>' +
                            '<td>' + dinhDangSo(x.DoanhThu) + 'đ</td>';
                        spBody.appendChild(tr);
                    });
                } else {
                    spBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted"><i>Không có dữ liệu</i></td></tr>';
                }

                // Doanh thu theo Danh mục
                var dmBody = document.querySelector('#tbDM tbody');
                dmBody.innerHTML = '';
                var tongDT = (d.DoanhThuTheoDanhMuc || []).reduce((s, x) => s + (x.DoanhThu || 0), 0);
                if (d.DoanhThuTheoDanhMuc && d.DoanhThuTheoDanhMuc.length) {
                    d.DoanhThuTheoDanhMuc.forEach(x => {
                        var ty = tongDT > 0 ? Math.round((x.DoanhThu * 100) / tongDT) : 0;
                        var tr = document.createElement('tr');
                        tr.innerHTML =
                            '<td>' + (x.TenDM || 'Khác') + '</td>' +
                            '<td>' + dinhDangSo(x.DoanhThu) + 'đ</td>' +
                            '<td><div class="thanh" title="' + ty + '%"><div class="fill" style="width:' + ty + '%;"></div></div></td>';
                        dmBody.appendChild(tr);
                    });
                } else {
                    dmBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted"><i>Không có dữ liệu</i></td></tr>';
                }

                // Voucher
                var vBody = document.querySelector('#tbVoucher tbody');
                vBody.innerHTML = '';
                if (d.Voucher && d.Voucher.length) {
                    d.Voucher.forEach(x => {
                        var tr = document.createElement('tr');
                        tr.innerHTML = '<td>' + (x.TenVoucher || '(không tên)') + '</td>' +
                            '<td>' + dinhDangSo(x.SoDon) + '</td>' +
                            '<td>' + dinhDangSo(x.DoanhThu) + 'đ</td>';
                        vBody.appendChild(tr);
                    });
                } else {
                    vBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted"><i>Không có dữ liệu</i></td></tr>';
                }
            }

            document.getElementById('btnTai').addEventListener('click', taiBaoCao);

            // Khởi chạy
            macDinhNgay();
            taiBaoCao();
        })();
    </script>
}