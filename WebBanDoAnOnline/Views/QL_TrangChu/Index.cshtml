@{
    ViewBag.Title = "Dashboard";
}

<main class="dashboard container-fluid py-4">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Ngân sách (Tháng)</div>
                    <div class="h3 text-primary fw-bold mt-2" id="lbl_NganSach">0</div>
                    <div class="small text-muted"><i class="fas fa-wallet me-1"></i> Kế hoạch chi tiêu</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Chi tiêu thực tế</div>
                    <div class="h3 text-danger fw-bold mt-2" id="lbl_ChiTieu">0</div>
                    <div class="small text-success" id="lbl_TrangThaiNganSach">An toàn</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Doanh thu bán hàng</div>
                    <div class="h3 text-success fw-bold mt-2" id="lbl_DoanhThu">0</div>
                    <div class="small text-success"><i class="fas fa-arrow-up me-1"></i> Tích lũy tháng</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Đơn hàng mới</div>
                    <div class="h3 text-warning fw-bold mt-2" id="lbl_DonMoi">0</div>
                    <div class="small text-muted">Chờ xác nhận</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <!-- THAY mở thẻ card của biểu đồ bằng đoạn dưới -->
            <div class="card dashboard-panel mb-3 border-0 shadow-sm" style="height:auto">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold text-secondary">Tổng quan tài chính</h5>
                        <span class="badge bg-light text-dark border">Tháng này</span>
                    </div>
                    <!-- HẠ chiều cao canvas + giảm margin-bottom -->
                    <div class="mb-2" style="height:220px">
                        <canvas id="chart_DoanhThuThang"></canvas>
                    </div>
                    <div class="small text-muted d-flex gap-3">
                        <span><i class="fas fa-receipt me-1 text-secondary"></i> Tổng đơn: <b id="lbl_TongDonThang">0</b></span>
                        <span><i class="fas fa-check-circle me-1 text-success"></i> Đã giao: <b id="lbl_DonDaGiao">0</b></span>
                        <span><i class="fas fa-times-circle me-1 text-danger"></i> Đã hủy: <b id="lbl_DonDaHuy">0</b></span>
                    </div>
                </div>
            </div>

            <div class="card dashboard-panel border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold text-secondary">Món ăn được yêu thích</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr class="small text-muted text-uppercase">
                                    <th>Tên món</th>
                                    <th>Giá bán</th>
                                    <th>Trạng thái</th>
                                    <th>Đánh giá</th>
                                </tr>
                            </thead>
                            <tbody id="tbl_MenuBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- VOUCHER CARD (Sửa) -->
            <div class="card dashboard-panel mb-3 border-0 shadow-sm">
                <div class="card-body">
                    <div class="voucher-header" style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                        <img src="/img/voucher.png" alt="Voucher" class="voucher-img"
                             style="width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid #eee;"
                             onerror="this.src='/img/no-image.jpg'">
                        <div>
                            <div class="fw-bold">Khuyến mãi</div>
                            <small class="text-muted">Chương trình đang chạy</small>
                        </div>
                    </div>
                    <div id="voucher-content" class="voucher-content">
                        <div class="voucher-title fw-bold text-danger" id="lbl_VoucherTitle">Đang tải...</div>
                        <div class="voucher-desc small text-muted" id="lbl_VoucherInfo">Vui lòng chờ dữ liệu.</div>
                    </div>
                </div>
            </div>

            <!-- Nhân sự mới giữ nguyên -->
            <div class="card dashboard-panel border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Nhân sự mới</h6>
                    <ul class="list-unstyled user-list mb-0" id="list_Staff"></ul>
                    <div class="text-center mt-3 border-top pt-2">
                        <a href="@Url.Action("QL_DanhSachNguoiDung", "NguoiDung")" class="small text-decoration-none fw-bold">Xem tất cả nhân viên</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
    var url_domain = window.location.origin;

    function DinhDangTienTe(n) {
        return Number(n).toFixed(0).replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.") + "đ";
    }
    function TaoTrangThai(status) {
        if (status === 'Còn hàng') return '<span class="badge bg-success-subtle text-success">Còn hàng</span>';
        if (status === 'Hết hàng') return '<span class="badge bg-danger-subtle text-danger">Hết hàng</span>';
        return '<span class="badge bg-secondary-subtle text-secondary">' + status + '</span>';
    }
    function getInitials(name) {
        if (!name) return "?";
        return name.split(" ").map(x => x[0]).join("").substring(0, 2).toUpperCase();
    }

    $(document).ready(function () {
        $.ajax({
            type: "POST",
            url: url_domain + '/QL_TrangChu/LayDuLieuDashBoard',
            contentType: false, processData: false, cache: false,
            success: function (response) {
                var data = JSON.parse(response);
                if (data.Error) { console.log(data.Error); return; }


                // Stats
                $("#lbl_NganSach").text(DinhDangTienTe(data.Stats.NganSach));
                $("#lbl_ChiTieu").text(DinhDangTienTe(data.Stats.ChiTieu));
                $("#lbl_DoanhThu").text(DinhDangTienTe(data.Stats.DoanhThu));
                $("#lbl_DonMoi").text(data.Stats.DonMoi);
                if (data.Stats && data.Stats.DonThang) {
                    $("#lbl_TongDonThang").text(data.Stats.DonThang.Tong);
                    $("#lbl_DonDaGiao").text(data.Stats.DonThang.DaGiao);
                    $("#lbl_DonDaHuy").text(data.Stats.DonThang.DaHuy);
                }
                if (data.Stats.ChiTieu > data.Stats.NganSach) {
                    $("#lbl_TrangThaiNganSach").html('<i class="fas fa-exclamation-triangle"></i> Vượt ngân sách!').removeClass("text-success").addClass("text-danger");
                } else {
                    $("#lbl_TrangThaiNganSach").html('<i class="fas fa-check-circle"></i> An toàn').removeClass("text-danger").addClass("text-success");
                }

                // Menu
                var menuHtml = "";
                if (!data.Menu || data.Menu.length === 0) {
                    menuHtml = '<tr><td colspan="4" class="text-center small text-muted">Chưa có món ăn nào.</td></tr>';
                } else {
                    for (var i = 0; i < data.Menu.length; i++) {
                        var item = data.Menu[i];
                        menuHtml += `
                        <tr>
                            <td class="fw-bold text-dark">${item.TenSP}</td>
                            <td>${DinhDangTienTe(item.Gia)}</td>
                            <td>${TaoTrangThai(item.TrangThai)}</td>
                            <td><i class="fas fa-star text-warning"></i> ${item.DiemDanhGia}</td>
                        </tr>`;
                    }
                }
                $("#tbl_MenuBody").html(menuHtml);

                // Staff
                var staffHtml = "";
                if (!data.Staff || data.Staff.length === 0) {
                    staffHtml = '<li class="text-center small text-muted">Chưa có nhân sự.</li>';
                } else {
                    for (var i = 0; i < data.Staff.length; i++) {
                        var u = data.Staff[i];
                        var roleColor = u.VaiTro === "Quản lý" ? "text-primary" : "text-muted";
                        staffHtml += `
                        <li class="d-flex align-items-center py-2 border-bottom-dashed">
                            <div class="avatar me-3 bg-light text-primary d-flex align-items-center justify-content-center rounded-circle fw-bold border" style="width:40px;height:40px">
                                ${getInitials(u.HoTen)}
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">${u.HoTen}</div>
                                <div class="small ${roleColor}" style="font-size:11px">${u.VaiTro}</div>
                            </div>
                        </li>`;
                    }
                }
                $("#list_Staff").html(staffHtml);

                // Voucher
                if (data.Voucher && data.Voucher.TenVoucher) {
                    $("#lbl_VoucherTitle").text(data.Voucher.TenVoucher);
                    $("#lbl_VoucherInfo").text(data.Voucher.MoTaThem || "Không có mô tả");
                } else {
                    $("#lbl_VoucherTitle").text("Không có chương trình nào đang chạy");
                    $("#lbl_VoucherInfo").text("Hiện không có ưu đãi.");
                }

                // Chart.js - 3 dataset: DoanhThuTheoNgay, DoanhThuLuyKe, MucTieuNganSach (+ Cashflow below)
                // Chart.js - cấu hình tối ưu để không thừa khoảng trắng dưới
                if (data.Chart && data.Chart.Labels) {
                    var ctx = document.getElementById('chart_DoanhThuThang').getContext('2d');

                    // đảm bảo chiều cao container (khớp với phần HTML ở trên)
                    document.getElementById('chart_DoanhThuThang').parentElement.style.height = '220px';

                    var gradientRevenue = ctx.createLinearGradient(0, 0, 0, 200);
                    gradientRevenue.addColorStop(0, 'rgba(25, 135, 84, 0.35)');
                    gradientRevenue.addColorStop(1, 'rgba(25, 135, 84, 0.05)');

                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.Chart.Labels,
                            datasets: [
                                {
                                    label: 'Doanh thu theo ngày',
                                    data: data.Chart.DoanhThuTheoNgay || [],
                                    tension: 0.3,
                                    borderColor: '#198754',
                                    backgroundColor: gradientRevenue,
                                    fill: true,
                                    pointRadius: 2,
                                    pointHoverRadius: 4
                                },
                                {
                                    label: 'Doanh thu lũy kế',
                                    data: data.Chart.DoanhThuLuyKe || [],
                                    tension: 0.2,
                                    borderColor: '#0d6efd',
                                    backgroundColor: 'rgba(13,110,253,0.08)',
                                    fill: false,
                                    pointRadius: 0
                                },
                                {
                                    label: 'Ngân sách mục tiêu',
                                    data: data.Chart.MucTieuNganSach || [],
                                    tension: 0,
                                    borderColor: '#6c757d',
                                    borderDash: [6, 4],
                                    fill: false,
                                    pointRadius: 0
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            // GIẢM khoảng trắng dư, đưa legend lên trên
                            layout: { padding: { top: 8, right: 8, bottom: 0, left: 8 } },
                            plugins: {
                                legend: { position: 'top', labels: { boxWidth: 14, padding: 8 } },
                                title: { display: true, text: data.Chart.Title, padding: { bottom: 6 } },
                                tooltip: {
                                    callbacks: {
                                        label: function (ctx) { return ' ' + DinhDangTienTe(ctx.parsed.y || 0); }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { maxRotation: 0, autoSkip: true, padding: 4 } // giảm đệm nhãn trục X
                                },
                                y: {
                                    grid: { color: '#eee' },
                                    ticks: {
                                        callback: function (value) { return DinhDangTienTe(value); },
                                        padding: 4 // giảm đệm nhãn trục Y
                                    }
                                }
                            },
                            elements: { line: { borderWidth: 2 } }
                        }
                    });
                }
            },
            error: function (err) {
                console.log("Lỗi tải Dashboard: " + err);
            }
        });
    });
</script>