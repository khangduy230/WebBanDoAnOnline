﻿@{
    ViewBag.Title = "Dashboard";
}

<main class="dashboard container-fluid py-4">
    <!-- Phần thống kê (Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Doanh thu bán hàng</div>
                    <div class="h3 text-success fw-bold mt-2" id="lbl_DoanhThu">0</div>
                    <div class="small text-success"><i class="fas fa-arrow-up me-1"></i> Tích lũy tháng</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small text-uppercase fw-bold">Đơn hàng mới</div>
                    <div class="h3 text-warning fw-bold mt-2" id="lbl_DonMoi">0</div>
                    <div class="small text-muted">Chờ xác nhận</div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 1: BIỂU ĐỒ & KHUYẾN MÃI -->
    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <!-- PHẦN BIỂU ĐỒ TÀI CHÍNH -->
            <div class="card dashboard-panel h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="mb-0 fw-bold text-secondary">Hiệu quả kinh doanh</h5>
                            <small class="text-muted">Doanh thu & Số lượng đơn hàng theo ngày</small>
                        </div>
                        <span class="badge bg-light text-dark border">Tháng này</span>
                    </div>

                    <!-- Container cho biểu đồ -->
                    <div class="chart-container" style="position: relative; height:300px; width:100%">
                        <canvas id="chart_TaiChinhHonHop"></canvas>
                    </div>

                    <div class="small text-muted d-flex gap-3 mt-3 justify-content-center">
                        <span><i class="fas fa-receipt me-1 text-secondary"></i> Tổng đơn: <b id="lbl_TongDonThang">0</b></span>
                        <span><i class="fas fa-check-circle me-1 text-success"></i> Đã giao: <b id="lbl_DonDaGiao">0</b></span>
                        <span><i class="fas fa-times-circle me-1 text-danger"></i> Đã hủy: <b id="lbl_DonDaHuy">0</b></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- PHẦN VOUCHER -->
            <div class="card dashboard-panel h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="voucher-header" style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                        
                        <div>
                            <div class="fw-bold">Khuyến mãi</div>
                            
                        </div>
                    </div>

                    <div id="voucher-content" class="voucher-content flex-grow-1">
                        <div class="voucher-title fw-bold text-danger" id="lbl_VoucherTitle">Đang tải...</div>
                        <div class="voucher-desc small text-muted" id="lbl_VoucherInfo">Vui lòng chờ dữ liệu.</div>
                    </div>
                    <div class="text-center mt-3 border-top pt-2">
                        <a href="@Url.Action("QL_DanhSachVoucher", "Voucher")" class="small text-decoration-none fw-bold">Xem tất cả voucher</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- HÀNG 2: BẢNG MÓN ĂN & NHÂN SỰ -->
    <div class="row g-3">
        <div class="col-lg-8">
            <!-- Bảng món ăn yêu thích -->
            <div class="card dashboard-panel border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3 fw-bold text-secondary">Món ăn được yêu thích</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr class="small text-muted text-uppercase">
                                    <th>Tên món</th>
                                    <th>Giá bán</th>
                                    <th>Trạng thái</th>
                                    <th>Đánh giá</th>
                                </tr>
                            </thead>
                            <tbody id="tbl_MenuBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card dashboard-panel border-0 shadow-sm h-100">
                <!-- THÊM CLASS: d-flex flex-column -->
                <div class="card-body d-flex flex-column">
                    <h6 class="fw-bold mb-3">Nhân sự mới</h6>

                    <!-- THÊM CLASS: flex-grow-1 -->
                    <ul class="list-unstyled user-list mb-0 flex-grow-1" id="list_Staff">
                        <!-- Nội dung danh sách nhân viên sẽ được JS render vào đây -->
                    </ul>

                    <div class="text-center mt-3 border-top pt-2">
                        <a href="@Url.Action("QL_DanhSachNguoiDung", "NguoiDung")" class="small text-decoration-none fw-bold">Xem tất cả nhân viên</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<!-- Sử dụng Chart.js phiên bản mới hơn để hỗ trợ tốt Mixed Charts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var url_domain = window.location.origin;

    function DinhDangTienTe(n) {
        return Number(n).toFixed(0).replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.") + "đ";
    }
    function TaoTrangThai(status) {
        if (status === 'Còn hàng') return '<span class="badge bg-success-subtle text-success">Còn hàng</span>';
        if (status === 'Hết hàng') return '<span class="badge bg-danger-subtle text-danger">Hết hàng</span>';
        return '<span class="badge bg-secondary-subtle text-secondary">' + status + '</span>';
    }
    function getInitials(name) {
        if (!name) return "?";
        return name.split(" ").map(x => x[0]).join("").substring(0, 2).toUpperCase();
    }

    $(document).ready(function () {
        $.ajax({
            type: "POST",
            url: url_domain + '/QL_TrangChu/LayDuLieuDashBoard',
            contentType: false, processData: false, cache: false,
            success: function (response) {
                var data = JSON.parse(response);
                if (data.Error) { console.log(data.Error); return; }

                // 1. Cập nhật các thẻ thống kê (Stats)
                $("#lbl_DoanhThu").text(DinhDangTienTe(data.Stats.DoanhThu));
                $("#lbl_DonMoi").text(data.Stats.DonMoi);

                if (data.Stats && data.Stats.DonThang) {
                    $("#lbl_TongDonThang").text(data.Stats.DonThang.Tong);
                    $("#lbl_DonDaGiao").text(data.Stats.DonThang.DaGiao);
                    $("#lbl_DonDaHuy").text(data.Stats.DonThang.DaHuy);
                }

                // 2. Cập nhật bảng món ăn (Menu)
                var menuHtml = "";
                if (!data.Menu || data.Menu.length === 0) {
                    menuHtml = '<tr><td colspan="4" class="text-center small text-muted">Chưa có món ăn nào.</td></tr>';
                } else {
                    for (var i = 0; i < data.Menu.length; i++) {
                        var item = data.Menu[i];
                        menuHtml += `
                        <tr>
                            <td class="fw-bold text-dark">${item.TenSP}</td>
                            <td>${DinhDangTienTe(item.Gia)}</td>
                            <td>${TaoTrangThai(item.TrangThai)}</td>
                            <td><i class="fas fa-star text-warning"></i> ${item.DiemDanhGia}</td>
                        </tr>`;
                    }
                }
                $("#tbl_MenuBody").html(menuHtml);

                // 3. Cập nhật danh sách nhân sự (Staff)
                var staffHtml = "";
                if (!data.Staff || data.Staff.length === 0) {
                    staffHtml = '<li class="text-center small text-muted">Chưa có nhân sự.</li>';
                } else {
                    for (var i = 0; i < data.Staff.length; i++) {
                        var u = data.Staff[i];
                        var roleColor = u.VaiTro === "Quản lý" ? "text-primary" : "text-muted";
                        staffHtml += `
                        <li class="d-flex align-items-center py-2 border-bottom-dashed">
                            <div class="avatar me-3 bg-light text-primary d-flex align-items-center justify-content-center rounded-circle fw-bold border" style="width:40px;height:40px">
                                ${getInitials(u.HoTen)}
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">${u.HoTen}</div>
                                <div class="small ${roleColor}" style="font-size:11px">${u.VaiTro}</div>
                            </div>
                        </li>`;
                    }
                }
                $("#list_Staff").html(staffHtml);

                // 4. Cập nhật Voucher
                if (data.Voucher && data.Voucher.TenVoucher) {
                    $("#lbl_VoucherTitle").text(data.Voucher.TenVoucher);
                    $("#lbl_VoucherInfo").text(data.Voucher.MoTaThem || "Không có mô tả");
                } else {
                    $("#lbl_VoucherTitle").text("Không có mã nào đang trong thời gian sử dụng");
                    $("#lbl_VoucherInfo").text("Hiện không có ưu đãi.");
                }

                // 5. VẼ BIỂU ĐỒ (Chart.js)
                if (data.Chart && data.Chart.Labels) {
                    var ctx = document.getElementById('chart_TaiChinhHonHop').getContext('2d');

                    // Tạo gradient màu cho cột doanh thu
                    var gradientBar = ctx.createLinearGradient(0, 0, 0, 300);
                    gradientBar.addColorStop(0, 'rgba(245, 134, 52, 0.8)'); // Màu cam đậm (Primary)
                    gradientBar.addColorStop(1, 'rgba(245, 134, 52, 0.3)'); // Màu cam nhạt

                    new Chart(ctx, {
                        type: 'bar', // Loại mặc định là Bar
                        data: {
                            labels: data.Chart.Labels, // Ngày trong tháng
                            datasets: [
                                {
                                    label: 'Doanh thu (VNĐ)',
                                    data: data.Chart.DoanhThuTheoNgay || [],
                                    backgroundColor: gradientBar,
                                    borderColor: '#F58634',
                                    borderWidth: 1,
                                    borderRadius: 4,
                                    order: 2, // Vẽ sau (nằm dưới)
                                    yAxisID: 'y' // Trục Y bên trái
                                },
                                {
                                    type: 'line', // Loại dataset này là Line
                                    label: 'Số đơn hàng',
                                    data: data.Chart.SoDonHangTheoNgay || [], // Cần đảm bảo Backend trả về field này, nếu chưa có thì dùng tạm mảng giả lập hoặc mảng 0
                                    borderColor: '#0d6efd', // Màu xanh dương
                                    backgroundColor: '#0d6efd',
                                    borderWidth: 2,
                                    tension: 0.4, // Đường cong mềm mại
                                    pointRadius: 3,
                                    pointHoverRadius: 5,
                                    order: 1, // Vẽ trước (nằm trên)
                                    yAxisID: 'y1' // Trục Y bên phải
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            plugins: {
                                legend: {
                                    position: 'top',
                                    labels: { usePointStyle: true, boxWidth: 8 }
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            var label = context.dataset.label || '';
                                            if (label) {
                                                label += ': ';
                                            }
                                            if (context.dataset.yAxisID === 'y') {
                                                label += DinhDangTienTe(context.parsed.y);
                                            } else {
                                                label += context.parsed.y + " đơn";
                                            }
                                            return label;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false }
                                },
                                y: {
                                    type: 'linear',
                                    display: true,
                                    position: 'left',
                                    title: { display: true, text: 'Doanh thu' },
                                    ticks: {
                                        callback: function (value) { return value >= 1000000 ? (value / 1000000).toFixed(1) + 'M' : value / 1000 + 'k'; }
                                    }
                                },
                                y1: {
                                    type: 'linear',
                                    display: true,
                                    position: 'right',
                                    title: { display: true, text: 'Số đơn' },
                                    grid: { drawOnChartArea: false }, // Ẩn lưới ngang của trục phải để đỡ rối
                                    min: 0,
                                    ticks: { stepSize: 1 }
                                }
                            }
                        }
                    });
                }
            },
            error: function (err) {
                console.log("Lỗi tải Dashboard: " + err);
            }
        });
    });</script>