@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_XacThucLayout.cshtml";
}

<style>
    /* CSS Cũ giữ nguyên */
    body {
        background-color: #f4f6f9;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-card {
        background: #ffffff;
        width: 100%;
        max-width: 500px;
        padding: 40px 35px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        margin: 20px;
        max-height: 90vh;
        overflow-y: auto;
        scrollbar-gutter: stable;
    }

    .auth-logo {
        text-align: center;
        margin-bottom: 10px;
        font-size: 28px;
    }

    .logo-bold {
        font-weight: 800;
        color: #333;
    }

    .logo-regular {
        font-weight: 400;
        color: #333;
    }

    .auth-title {
        text-align: center;
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
        color: #555;
        margin-bottom: 5px;
        display: block;
    }

    .custom-input {
        width: 100%;
        padding: 10px 15px;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        font-size: 15px;
        outline: none;
        transition: all 0.3s;
    }

        .custom-input:focus {
            border-color: #fd7e14;
            box-shadow: 0 0 0 3px rgba(253, 126, 20, 0.15);
        }

    .password-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        top: 50%;
        right: 15px;
        transform: translateY(-50%);
        cursor: pointer;
        color: #aaa;
    }

    .btn-action {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        margin-top: 10px;
        transition: background 0.3s;
    }

    .btn-register {
        background-color: #fd7e14;
        color: white;
    }

        .btn-register:hover {
            background-color: #e96b02;
        }

    .btn-back {
        background-color: white;
        color: #555;
        border: 1px solid #ddd;
        display: block;
        text-align: center;
        text-decoration: none;
        margin-top: 10px;
    }

        .btn-back:hover {
            background-color: #f8f9fa;
            color: #333;
        }

    .alert-custom {
        padding: 10px;
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 20px;
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="login-card">
    <div class="auth-logo">
        <span class="logo-bold fst-italic">FuTho</span>
        <span class="logo-regular">Food</span>
    </div>
    <h2 class="auth-title">Đăng ký tài khoản mới</h2>

    <!-- Form -->
    <form id="reg_frm" method="post">
        <!-- Báo lỗi chung -->
        <div id="error-msg" class="alert-custom" style="display:none;"></div>

        <div class="form-group">
            <label class="form-label">Họ và tên</label>
            <input type="text" id="txt_name" name="txt_name" class="custom-input" placeholder="Nhập họ tên" />
        </div>

        <div class="form-group">
            <label class="form-label">Tên tài khoản</label>
            <input type="text" id="txt_user" name="txt_user" class="custom-input" placeholder="Viết liền không dấu" />
        </div>

        <div class="form-group">
            <label class="form-label">Số điện thoại</label>
            <input type="text" id="txt_phone" name="txt_phone" class="custom-input" placeholder="Nhập SĐT (9-11 số)"
                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
        </div>

        <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" id="txt_email" name="txt_email" class="custom-input" placeholder="example@gmail.com" />
        </div>

        <div class="form-group">
            <label class="form-label">Mật khẩu</label>
            <div class="password-wrapper">
                <input type="password" id="txt_pass" name="txt_pass" class="custom-input" placeholder="Tối thiểu 6 ký tự" />
                <i class="fas fa-eye-slash toggle-password"></i>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Xác nhận mật khẩu</label>
            <div class="password-wrapper">
                <input type="password" id="txt_repass" name="txt_repass" class="custom-input" placeholder="Nhập lại mật khẩu" />
                <i class="fas fa-eye-slash toggle-password"></i>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Câu hỏi bảo mật (Dùng khi quên mật khẩu)</label>
            <!-- THÊM ID: id="ddl_question" -->
            <select id="ddl_question" name="CauHoiBaoMat" class="custom-input" style="background-color: white;">
                <option value="">-- Chọn câu hỏi --</option>
                <option value="Bạn thích ăn món gì nhất">Bạn thích ăn món gì nhất?</option>
                <option value="Bạn thích điều gì nhất ở nhà hàng của chúng tôi">Bạn thích điều gì nhất ở nhà hàng của chúng tôi?</option>
                <option value="Tên thú cưng đầu tiên của bạn là gì">Tên thú cưng đầu tiên của bạn là gì?</option>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Câu trả lời</label>
            <!-- THÊM ID: id="txt_answer" -->
            <input type="text" id="txt_answer" name="CauTraLoiBaoMat" class="custom-input" placeholder="Nhập câu trả lời của bạn" />
        </div>

        <button type="button" id="btn_register" class="btn-action btn-register">Đăng ký ngay</button>
        <a href="/TaiKhoan/DangNhap" class="btn-action btn-back">Quay lại đăng nhập</a>
    </form>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(document).ready(function () {

        $("#btn_register").click(function () {
            // 1. Lấy giá trị
            var name = $("#txt_name").val().trim();
            var user = $("#txt_user").val().trim();
            var phone = $("#txt_phone").val().trim();
            var email = $("#txt_email").val().trim();
            var pass = $("#txt_pass").val();
            var repass = $("#txt_repass").val();
            // Lấy giá trị câu hỏi và trả lời (MỚI)
            var question = $("#ddl_question").val();
            var answer = $("#txt_answer").val().trim();

            // 2. Validate Dữ liệu

            // 2.1 Kiểm tra thông tin cơ bản
            if (name == "" || user == "" || phone == "" || email == "") {
                Error("Vui lòng nhập đầy đủ thông tin cá nhân!"); return;
            }

            // 2.2 Validate Câu hỏi bảo mật (MỚI)
            if (question == "") {
                Error("Vui lòng chọn câu hỏi bảo mật!"); return;
            }
            if (answer == "") {
                Error("Vui lòng nhập câu trả lời cho câu hỏi bảo mật!"); return;
            }

            // 2.3 Validate SĐT
            if (!/^\d{9,11}$/.test(phone)) {
                Error("Số điện thoại phải là số và có từ 9-11 ký tự!"); return;
            }

            // 2.4 Validate Email
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(email)) {
                Error("Email không đúng định dạng!"); return;
            }

            // 2.5 Validate Mật khẩu
            if (pass == "" || repass == "") { Error("Vui lòng nhập mật khẩu!"); return; }
            if (pass.length < 6) { Error("Mật khẩu phải tối thiểu 6 ký tự!"); return; }
            if (pass !== repass) { Error("Mật khẩu xác nhận không khớp!"); return; }


            // 3. Gửi AJAX
            var formData = new FormData($('#reg_frm')[0]);

            $.ajax({
                type: "POST",
                url: '/TaiKhoan/XuLiDangKy',
                data: formData,
                processData: false, contentType: false,
                beforeSend: function () {
                    $("#btn_register").text("Đang xử lý...").prop("disabled", true);
                    $("#error-msg").hide();
                },
                success: function (rs) {
                    if (rs.success) {
                        alert("Đăng ký thành công! Vui lòng đăng nhập.");
                        window.location.href = "/TaiKhoan/DangNhap";
                    } else {
                        Error(rs.message);
                        $("#btn_register").text("Đăng ký ngay").prop("disabled", false);
                    }
                },
                error: function () {
                    Error("Lỗi kết nối Server.");
                    $("#btn_register").text("Đăng ký ngay").prop("disabled", false);
                }
            });
        });

        function Error(msg) {
            // Hiển thị lỗi ra thẻ div và scroll lên trên để user thấy
            $("#error-msg").text(msg).fadeIn();
            $('.login-card').scrollTop(0);
        }

        // Ẩn/Hiện mật khẩu
        $(".toggle-password").click(function () {
            var input = $(this).siblings("input");
            if (input.attr("type") === "password") {
                input.attr("type", "text");
                $(this).removeClass("fa-eye-slash").addClass("fa-eye");
            } else {
                input.attr("type", "password");
                $(this).removeClass("fa-eye").addClass("fa-eye-slash");
            }
        });
    });
</script>